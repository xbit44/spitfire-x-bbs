# Private static dependencies; never install into the host's package directories.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "The Linux Runtime currently requires AMD64 Linux")
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    message(FATAL_ERROR "The Linux Runtime currently requires an AMD64 compiler")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SfxSshSources.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SfxLinuxOpenSSL.cmake")
set(SFX_DEUCESSH_LINUX_CONN "${CMAKE_CURRENT_SOURCE_DIR}/third_party/deucessh/ed49634/patches/linux-monotonic-v1/ssh-conn.c")
file(SHA256 "${SFX_DEUCESSH_LINUX_CONN}" SFX_DEUCESSH_LINUX_CONN_SHA256)
if(NOT SFX_DEUCESSH_LINUX_CONN_SHA256 STREQUAL "0ff8dbea3e3c4fde61031750d0b3672076d2daaf480d945136e361d7a6caa189")
    message(FATAL_ERROR "Linux SSH clock overlay identity mismatch")
endif()
set(SFX_DEUCESSH_LINUX_OVERLAY "${SFX_SSH_THIRD_PARTY}/linux-monotonic-0ff8dbea3e3c")
file(COPY "${SFX_DEUCESSH_OVERLAY}/" DESTINATION "${SFX_DEUCESSH_LINUX_OVERLAY}" PATTERN "ssh-conn.c" EXCLUDE)
configure_file("${SFX_DEUCESSH_LINUX_CONN}" "${SFX_DEUCESSH_LINUX_OVERLAY}/ssh-conn.c" COPYONLY)
# The pinned private OpenSSL target already supplies headers and link inputs.
# Upstream's package lookup can add host pkg-config dependencies to its archive.
file(READ "${SFX_DEUCESSH_OVERLAY}/CMakeLists.txt" deucessh_cmake)
set(deucessh_openssl_lookup "find_package(OpenSSL 3.0 REQUIRED)")
set(deucessh_openssl_interface [=[set(DSSH_CRYPTO_LIB_INTERFACE ${OPENSSL_CRYPTO_LIBRARIES})]=])
string(FIND "${deucessh_cmake}" "${deucessh_openssl_lookup}" openssl_lookup_offset)
string(FIND "${deucessh_cmake}" "${deucessh_openssl_interface}" openssl_interface_offset)
if(openssl_lookup_offset EQUAL -1 OR openssl_interface_offset EQUAL -1)
    message(FATAL_ERROR "Pinned DeuceSSH OpenSSL integration changed")
endif()
string(REPLACE "${deucessh_openssl_lookup}" "# SFX supplies the private OpenSSL target." deucessh_cmake "${deucessh_cmake}")
string(REPLACE "${deucessh_openssl_interface}" "set(DSSH_CRYPTO_LIB_INTERFACE OpenSSL::Crypto)" deucessh_cmake "${deucessh_cmake}")
file(WRITE "${SFX_DEUCESSH_LINUX_OVERLAY}/CMakeLists.txt" "${deucessh_cmake}")
set(SFX_DEUCESSH_OVERLAY "${SFX_DEUCESSH_LINUX_OVERLAY}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SFX_DEUCESSH_LINUX_CONN}")
set(DEUCESSH_CRYPTO_BACKEND OpenSSL CACHE STRING "SFX SSH backend" FORCE)
set(DEUCESSH_BUILD_STATIC ON CACHE BOOL "Static SSH" FORCE)
set(DEUCESSH_BUILD_SHARED OFF CACHE BOOL "No shared SSH" FORCE)
set(DEUCESSH_BUILD_TESTS OFF CACHE BOOL "Explicit qualification targets" FORCE)
function(sfx_add_linux_ssh_dependency)
    # Upstream's C17 probe must not inherit the application's C99 -std flag.
    set(CMAKE_C_STANDARD 17)
    unset(HAVE_TIMESPEC_GET CACHE)
    add_subdirectory("${SFX_DEUCESSH_OVERLAY}" "${SFX_SSH_THIRD_PARTY}/deucessh" EXCLUDE_FROM_ALL)
endfunction()
sfx_add_linux_ssh_dependency()
add_dependencies(deucessh_static sfx_openssl_crypto_build)
