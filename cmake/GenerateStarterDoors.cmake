# Pinned standalone runtime inputs. Never build either standalone door here.
set(STARTER_GAME "${STARTER_DOOR_ROOT}/SFXGuess-a-Number-1.0.1-Win32-Win7-test-r1.zip")
set(STARTER_NEWS "${STARTER_DOOR_ROOT}/newswire-x-rss/0.1.0-rc1/NewsWire-X-RSS-0.1.0-rc1-Win32-install-ca20261105-r1.zip")
set(STARTER_GAME_HASH "d9d4edf8a48498c21161c7e9ea5304deb993b5006bd21571952cdefcd8935824")
set(STARTER_NEWS_HASH "2929fa9b10c82d469a6fb1a9dbcbf367fa8e770050496b661d3d7ff4cf61ddf4")
set(STARTER_GAME_FILES file_id.diz LICENSE SFXGuess32.exe sysop.txt THIRD_PARTY.txt WIN7_TEST.txt)
set(STARTER_NEWS_FILES NewsWire-X-RSS.exe sysop.txt file_id.diz LICENSE QUALIFICATION.txt
    config/cacert.pem config/newsfeeds.json notices/curl.txt notices/MbedTLS.txt
    notices/zlib.txt notices/Lexbor.txt notices/Lexbor-NOTICE.txt notices/pugixml.txt
    notices/Mozilla-CA-LICENSE.txt notices/Mozilla-CA-PROVENANCE.md
    notices/nlohmann-json.txt notices/DEPENDENCIES.txt)
file(WRITE "${OUTPUT_DIRECTORY}/starter_door_payload.inc"
    "struct StarterDoorAsset { int resource_id; const wchar_t* filename; const char* sha256; };\nconstexpr std::array<StarterDoorAsset,23> starter_door_assets{{\n")
set(STARTER_RESOURCE 300)
set(STARTER_DOC_ROWS "")
set(STARTER_DOC_FILES 0)
foreach(STARTER_KIND GAME NEWS)
    file(SHA256 "${STARTER_${STARTER_KIND}}" STARTER_ACTUAL)
    if(NOT STARTER_ACTUAL STREQUAL STARTER_${STARTER_KIND}_HASH)
        message(FATAL_ERROR "Starter ${STARTER_KIND} differs from owner-tested runtime input")
    endif()
    set(STARTER_EXTRACT "${OUTPUT_DIRECTORY}/starter-${STARTER_ACTUAL}")
    file(MAKE_DIRECTORY "${STARTER_EXTRACT}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${STARTER_${STARTER_KIND}}"
        WORKING_DIRECTORY "${STARTER_EXTRACT}" RESULT_VARIABLE STARTER_RESULT)
    if(NOT STARTER_RESULT EQUAL 0)
        message(FATAL_ERROR "Starter runtime archive extraction failed")
    endif()
    file(GLOB_RECURSE STARTER_MEMBERS LIST_DIRECTORIES false RELATIVE "${STARTER_EXTRACT}" "${STARTER_EXTRACT}/*")
    set(STARTER_EXPECTED ${STARTER_${STARTER_KIND}_FILES})
    list(SORT STARTER_MEMBERS)
    list(SORT STARTER_EXPECTED)
    if(NOT STARTER_MEMBERS STREQUAL STARTER_EXPECTED)
        message(FATAL_ERROR "Starter payload must contain only approved runtime, config and notices")
    endif()
    if(STARTER_KIND STREQUAL GAME)
        set(STARTER_COMPONENT SFXGuess32)
    else()
        set(STARTER_COMPONENT NewsWire-X-RSS)
    endif()
    foreach(STARTER_MEMBER IN LISTS STARTER_EXPECTED)
        set(STARTER_FILE "${STARTER_EXTRACT}/${STARTER_MEMBER}")
        file(SHA256 "${STARTER_FILE}" STARTER_HASH)
        string(TOUPPER "${STARTER_HASH}" STARTER_HASH)
        file(TO_CMAKE_PATH "${STARTER_FILE}" STARTER_FILE)
        set(STARTER_DESTINATION "Doors/${STARTER_COMPONENT}/${STARTER_MEMBER}")
        if(NOT STARTER_MEMBER MATCHES "[.]exe$" AND NOT STARTER_MEMBER MATCHES "^config/")
            set(STARTER_DESTINATION "Docs/Doors/${STARTER_COMPONENT}/${STARTER_MEMBER}")
            string(APPEND STARTER_DOC_ROWS "    {${STARTER_RESOURCE}, L\"${STARTER_DESTINATION}\", \"${STARTER_HASH}\"},\n")
            math(EXPR STARTER_DOC_FILES "${STARTER_DOC_FILES} + 1")
        endif()
        file(APPEND "${OUTPUT_DIRECTORY}/payload.rc" "${STARTER_RESOURCE} RCDATA \"${STARTER_FILE}\"\n")
        file(APPEND "${OUTPUT_DIRECTORY}/starter_door_payload.inc"
            "    {${STARTER_RESOURCE}, L\"${STARTER_DESTINATION}\", \"${STARTER_HASH}\"},\n")
        math(EXPR STARTER_RESOURCE "${STARTER_RESOURCE} + 1")
    endforeach()
endforeach()
file(APPEND "${OUTPUT_DIRECTORY}/starter_door_payload.inc" "}};\n")
