        message(FATAL_ERROR "General file helper differs from exact qualified candidate")
    endif()
    file(SHA256 "${FILE_MANAGER}" FILE_MANAGER_HASH)
    string(TOUPPER "${FILE_HELPER_HASH}" FILE_HELPER_HASH)
    string(TOUPPER "${FILE_MANAGER_HASH}" FILE_MANAGER_HASH)
    file(TO_CMAKE_PATH "${FILE_HELPER}" FILE_HELPER_PATH)
    file(TO_CMAKE_PATH "${FILE_MANAGER}" FILE_MANAGER_PATH)
