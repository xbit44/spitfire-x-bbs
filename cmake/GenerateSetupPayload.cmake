string(TOUPPER "${ZIP_HASH}" ZIP_HASH)
string(TOUPPER "${UNZIP_HASH}" UNZIP_HASH)
string(TOUPPER "${CONFIG_HASH}" CONFIG_HASH)
string(TOUPPER "${MESSAGE_HELPER_HASH}" MESSAGE_HELPER_HASH)
# The embedded manifest is a byte contract, not a platform-native text file.
if(DEFINED MAINTENANCE AND NOT MAINTENANCE STREQUAL "")
