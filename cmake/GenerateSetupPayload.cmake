    file(CONFIGURE OUTPUT "${OUTPUT_DIRECTORY}/manifest.txt"
        CONTENT "SFX-PAYLOAD-4\n${CP_HASH}\n${RT_HASH}\n${ZIP_HASH}\n${UNZIP_HASH}\n${CONFIG_HASH}\n${MESSAGE_HELPER_HASH}\n" @ONLY NEWLINE_STYLE LF)
endif()
file(TO_CMAKE_PATH "${CONTROL_PANEL}" CP_PATH)
if(DEFINED DOS_HOST AND NOT DOS_HOST STREQUAL "")
    foreach(kind HOST LAUNCHER DRIVER INI)
        if(NOT EXISTS "${DOS_${kind}}")
            message(FATAL_ERROR "Normal Door payload requires DOS_${kind}")
        endif()
        file(SHA256 "${DOS_${kind}}" DOS_${kind}_HASH)
        string(TOUPPER "${DOS_${kind}_HASH}" DOS_${kind}_HASH)
        file(TO_CMAKE_PATH "${DOS_${kind}}" DOS_${kind}_PATH)
    endforeach()
    if(NOT DOS_DRIVER_HASH STREQUAL "D36589BDE11134B7F6019C32667B639BC465CA39CD39E22FEB6E053A2996A3F3" OR
       NOT DOS_LAUNCHER_HASH STREQUAL "7512CC632275C310C29E3C8FF5554270C4C7885CF637A1528CCC8A47A101FBA2")
        message(FATAL_ERROR "Normal Door payload pair differs from the pinned candidate")
    endif()
    set(DOS_MANIFEST "SFX-PAYLOAD-8\n")
    foreach(image CP RT ZIP UNZIP CONFIG MESSAGE_HELPER PACKET_HELPER FILE_HELPER FILE_MANAGER MAINTENANCE DOS_HOST)
        string(APPEND DOS_MANIFEST "PE32 ${${image}_HASH}\n")
    endforeach()
    string(APPEND DOS_MANIFEST "MZ16 ${DOS_LAUNCHER_HASH}\nPE32-DLL ${DOS_DRIVER_HASH}\nINI-PRESERVE ${DOS_INI_HASH}\n")
    file(CONFIGURE OUTPUT "${OUTPUT_DIRECTORY}/manifest.txt" CONTENT "${DOS_MANIFEST}" @ONLY NEWLINE_STYLE LF)
