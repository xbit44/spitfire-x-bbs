    string(TOUPPER "${MAINTENANCE_HASH}" MAINTENANCE_HASH)
    file(TO_CMAKE_PATH "${MAINTENANCE}" MAINTENANCE_PATH)
    file(CONFIGURE OUTPUT "${OUTPUT_DIRECTORY}/manifest.txt"
        CONTENT "SFX-PAYLOAD-7\n${CP_HASH}\n${RT_HASH}\n${ZIP_HASH}\n${UNZIP_HASH}\n${CONFIG_HASH}\n${MESSAGE_HELPER_HASH}\n${PACKET_HELPER_HASH}\n${FILE_HELPER_HASH}\n${FILE_MANAGER_HASH}\n${MAINTENANCE_HASH}\n" @ONLY NEWLINE_STYLE LF)
elseif(DEFINED FILE_HELPER AND NOT FILE_HELPER STREQUAL "")
    file(CONFIGURE OUTPUT "${OUTPUT_DIRECTORY}/manifest.txt"
        CONTENT "SFX-PAYLOAD-6\n${CP_HASH}\n${RT_HASH}\n${ZIP_HASH}\n${UNZIP_HASH}\n${CONFIG_HASH}\n${MESSAGE_HELPER_HASH}\n${PACKET_HELPER_HASH}\n${FILE_HELPER_HASH}\n${FILE_MANAGER_HASH}\n" @ONLY NEWLINE_STYLE LF)
