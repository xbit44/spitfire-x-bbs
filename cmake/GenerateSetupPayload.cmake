# Mutable stock menus have a separate create-missing policy and never enter the
# protected program receipt. Verify source hashes before embedding each asset.
file(READ "${STOCK_MENU_ROOT}/stock-menu-manifest.json" MENU_MANIFEST)
string(JSON MENU_COUNT LENGTH "${MENU_MANIFEST}" files)
if(NOT MENU_COUNT EQUAL 25)
    message(FATAL_ERROR "Stock manifest must contain twenty-five current display assets")
endif()
file(WRITE "${OUTPUT_DIRECTORY}/stock_menu_payload.inc"
    "struct StockMenuAsset { int resource_id; const wchar_t* filename; const char* sha256; };\nconstexpr std::array<StockMenuAsset,25> stock_menu_assets{{\n")
set(MENU_RESOURCE 208)
foreach(base main main999 file msg your chat bullet1 batch)
    # Keep all remaining resource identities stable; 214..217 are retired.
    if(base STREQUAL "msg")
        set(MENU_RESOURCE 218)
    endif()
    foreach(extension ans asc)
        set(MENU_NAME "${base}.${extension}")
        set(MENU_FILE "${STOCK_MENU_ROOT}/Display/${MENU_NAME}")
        file(SHA256 "${MENU_FILE}" MENU_HASH)
        string(JSON EXPECTED_HASH GET "${MENU_MANIFEST}" files "${MENU_NAME}" sha256)
        if(NOT MENU_HASH STREQUAL EXPECTED_HASH)
            message(FATAL_ERROR "Stock menu hash mismatch: ${MENU_NAME}")
        endif()
        string(TOUPPER "${MENU_HASH}" MENU_HASH)
        file(TO_CMAKE_PATH "${MENU_FILE}" MENU_PATH)
        file(APPEND "${OUTPUT_DIRECTORY}/payload.rc" "${MENU_RESOURCE} RCDATA \"${MENU_PATH}\"\n")
        file(APPEND "${OUTPUT_DIRECTORY}/stock_menu_payload.inc"
            "    {${MENU_RESOURCE},L\"${MENU_NAME}\",\"${MENU_HASH}\"},\n")
        math(EXPR MENU_RESOURCE "${MENU_RESOURCE}+1")
    endforeach()
endforeach()
# Keep remaining resource IDs unchanged and preserve helper resource 228.
# The owner supplied BULLET2.ASC only; never fabricate a companion ANSI file.
set(MENU_RESOURCE 229)
foreach(MENU_NAME bulletin.ans bulletin.asc bullet2.asc qwk.ans qwk.asc chat-emote.txt sysop.ans sysop.asc spitfire-x.ans)
    # 234..241 remain owned by existing helper and DOS payloads.
    if(MENU_NAME STREQUAL "chat-emote.txt")
        set(MENU_RESOURCE 242)
    endif()
    set(MENU_FILE "${STOCK_MENU_ROOT}/Display/${MENU_NAME}")
    file(SHA256 "${MENU_FILE}" MENU_HASH)
    string(JSON EXPECTED_HASH GET "${MENU_MANIFEST}" files "${MENU_NAME}" sha256)
    if(NOT MENU_HASH STREQUAL EXPECTED_HASH)
        message(FATAL_ERROR "Stock menu hash mismatch: ${MENU_NAME}")
    endif()
    string(TOUPPER "${MENU_HASH}" MENU_HASH)
    file(TO_CMAKE_PATH "${MENU_FILE}" MENU_PATH)
    file(APPEND "${OUTPUT_DIRECTORY}/payload.rc" "${MENU_RESOURCE} RCDATA \"${MENU_PATH}\"\n")
    file(APPEND "${OUTPUT_DIRECTORY}/stock_menu_payload.inc"
        "    {${MENU_RESOURCE},L\"${MENU_NAME}\",\"${MENU_HASH}\"},\n")
    math(EXPR MENU_RESOURCE "${MENU_RESOURCE}+1")
endforeach()
file(APPEND "${OUTPUT_DIRECTORY}/stock_menu_payload.inc" "}};\n")
