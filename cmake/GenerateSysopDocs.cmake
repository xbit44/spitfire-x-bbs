# Only the reviewed starter manifest can enter the shipping documentation payload.
get_filename_component(SYSOP_PROJECT "${STOCK_MENU_ROOT}" DIRECTORY)
set(SYSOP_MANIFEST "${SYSOP_PROJECT}/distribution/windows/sysop-docs-manifest.json")
file(READ "${SYSOP_MANIFEST}" SYSOP_JSON)
string(JSON SYSOP_COUNT LENGTH "${SYSOP_JSON}" files)
math(EXPR SYSOP_LAST "${SYSOP_COUNT} - 1")
file(READ "${SYSOP_PROJECT}/src/apps/product_version.h" SYSOP_VERSION_HEADER)
string(REGEX MATCH "#define SFX_PRODUCT_VERSION_SHORT_STRING \"([^\"]+)\"" _ "${SYSOP_VERSION_HEADER}")
set(SYSOP_VERSION "${CMAKE_MATCH_1}")
string(REGEX MATCH "#define SFX_PRODUCT_RELEASE_DATE \"([^\"]+)\"" _ "${SYSOP_VERSION_HEADER}")
set(SYSOP_DATE "${CMAKE_MATCH_1}")
if(SYSOP_VERSION STREQUAL "" OR SYSOP_DATE STREQUAL "")
    message(FATAL_ERROR "Sysop README requires explicit release metadata")
endif()
set(SYSOP_ROWS "")
set(SYSOP_RESOURCE 400)
set(SYSOP_FILES 0)
file(GLOB_RECURSE SYSOP_WIKI_INPUTS LIST_DIRECTORIES false
    RELATIVE "${SYSOP_PROJECT}" "${SYSOP_PROJECT}/docs/sysop/*")
set(SYSOP_REQUIRED_INPUTS ${SYSOP_WIKI_INPUTS}
    "distribution/windows/README.txt")
foreach(SYSOP_REQUIRED IN ITEMS docs/sysop/wiki.html docs/sysop/search.html
        docs/sysop/assets/search-index.js docs/sysop/assets/search.js
        docs/sysop/assets/sysop.css docs/sysop/images/sfx-about-approved.png)
    if(NOT SYSOP_REQUIRED IN_LIST SYSOP_WIKI_INPUTS)
        message(FATAL_ERROR "Required starter Wiki asset missing: ${SYSOP_REQUIRED}")
    endif()
endforeach()
set(SYSOP_ADMITTED_INPUTS "")
foreach(SYSOP_INDEX RANGE 0 ${SYSOP_LAST})
    string(JSON SYSOP_SOURCE GET "${SYSOP_JSON}" files ${SYSOP_INDEX} path)
    if(SYSOP_SOURCE MATCHES "^docs/sysop/([A-Za-z0-9_./-]+)$")
        set(SYSOP_RELATIVE "${CMAKE_MATCH_1}")
        if(SYSOP_RELATIVE MATCHES "(^|/)\\.\\.(/|$)" OR SYSOP_RELATIVE STREQUAL "index.html")
            message(FATAL_ERROR "Invalid starter documentation path")
        endif()
        set(SYSOP_DESTINATION "Docs/Sysop/${SYSOP_RELATIVE}")
    elseif(SYSOP_SOURCE STREQUAL "distribution/windows/README.txt")
        set(SYSOP_DESTINATION "README.txt")
    else()
        continue() # Reference SPITFIRE.txt and authoring material are never shipped.
    endif()
    if(SYSOP_SOURCE IN_LIST SYSOP_ADMITTED_INPUTS)
        message(FATAL_ERROR "Duplicate starter documentation entry: ${SYSOP_SOURCE}")
    endif()
    list(APPEND SYSOP_ADMITTED_INPUTS "${SYSOP_SOURCE}")
    set(SYSOP_INPUT "${SYSOP_PROJECT}/${SYSOP_SOURCE}")
    string(JSON SYSOP_EXPECTED GET "${SYSOP_JSON}" files ${SYSOP_INDEX} sha256)
    file(SHA256 "${SYSOP_INPUT}" SYSOP_HASH)
    string(TOUPPER "${SYSOP_HASH}" SYSOP_HASH)
    if(NOT SYSOP_HASH STREQUAL SYSOP_EXPECTED)
        message(FATAL_ERROR "Starter documentation binding changed: ${SYSOP_SOURCE}")
    endif()
    if(SYSOP_DESTINATION STREQUAL "README.txt")
        file(READ "${SYSOP_INPUT}" SYSOP_README)
        string(REPLACE "[VERSION]" "${SYSOP_VERSION}" SYSOP_README "${SYSOP_README}")
        string(REPLACE "[RELEASE DATE]" "${SYSOP_DATE}" SYSOP_README "${SYSOP_README}")
        string(REPLACE "\r\n" "\n" SYSOP_README "${SYSOP_README}")
        set(SYSOP_INPUT "${OUTPUT_DIRECTORY}/README.txt")
        # Native file(WRITE) can translate LF again on Windows. Use one
        # explicit newline-style writer over the complete text. Protect literal
        # @ characters from template substitution without changing owner prose.
        set(SYSOP_LITERAL_AT "@")
        string(REPLACE "@" "@SYSOP_LITERAL_AT@" SYSOP_README "${SYSOP_README}")
        file(CONFIGURE OUTPUT "${SYSOP_INPUT}" CONTENT "${SYSOP_README}"
            @ONLY NEWLINE_STYLE CRLF)
        file(SHA256 "${SYSOP_INPUT}" SYSOP_HASH)
        string(TOUPPER "${SYSOP_HASH}" SYSOP_HASH)
    endif()
    file(APPEND "${OUTPUT_DIRECTORY}/payload.rc" "${SYSOP_RESOURCE} RCDATA \"${SYSOP_INPUT}\"\n")
    string(APPEND SYSOP_ROWS "    {${SYSOP_RESOURCE}, L\"${SYSOP_DESTINATION}\", \"${SYSOP_HASH}\"},\n")
    math(EXPR SYSOP_RESOURCE "${SYSOP_RESOURCE} + 1")
    math(EXPR SYSOP_FILES "${SYSOP_FILES} + 1")
endforeach()
list(SORT SYSOP_REQUIRED_INPUTS)
list(SORT SYSOP_ADMITTED_INPUTS)
if(NOT SYSOP_ADMITTED_INPUTS STREQUAL SYSOP_REQUIRED_INPUTS)
    message(FATAL_ERROR "Expected one root README and every Wiki file bound by the reviewed starter manifest")
endif()
# Core notices are a separately curated, exact source list. The Wiki manifest
# remains exhaustive for the Wiki; build/internal metadata is not embedded.
file(READ "${SYSOP_PROJECT}/distribution/ThirdParty/manifest.json" SYSOP_NOTICE_JSON)
string(JSON SYSOP_NOTICE_COUNT LENGTH "${SYSOP_NOTICE_JSON}" files)
math(EXPR SYSOP_NOTICE_LAST "${SYSOP_NOTICE_COUNT} - 1")
foreach(SYSOP_INDEX RANGE 0 ${SYSOP_NOTICE_LAST})
    string(JSON SYSOP_SOURCE GET "${SYSOP_NOTICE_JSON}" files ${SYSOP_INDEX} path)
    string(JSON SYSOP_DESTINATION GET "${SYSOP_NOTICE_JSON}" files ${SYSOP_INDEX} destination)
    string(JSON SYSOP_EXPECTED GET "${SYSOP_NOTICE_JSON}" files ${SYSOP_INDEX} sha256)
    if(NOT SYSOP_SOURCE MATCHES "^distribution/(ThirdParty|windows)/[A-Za-z0-9_./-]+$" OR
       NOT SYSOP_DESTINATION MATCHES "^Docs/ThirdParty/[A-Za-z0-9_./-]+$" OR
       SYSOP_SOURCE MATCHES "(^|/)\\.\\.(/|$)" OR SYSOP_DESTINATION MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Invalid curated core notice path")
    endif()
    set(SYSOP_INPUT "${SYSOP_PROJECT}/${SYSOP_SOURCE}")
    file(SHA256 "${SYSOP_INPUT}" SYSOP_HASH)
    string(TOUPPER "${SYSOP_HASH}" SYSOP_HASH)
    if(NOT SYSOP_HASH STREQUAL SYSOP_EXPECTED)
        message(FATAL_ERROR "Core notice source binding changed: ${SYSOP_SOURCE}")
    endif()
    file(APPEND "${OUTPUT_DIRECTORY}/payload.rc" "${SYSOP_RESOURCE} RCDATA \"${SYSOP_INPUT}\"\n")
    string(APPEND SYSOP_ROWS "    {${SYSOP_RESOURCE}, L\"${SYSOP_DESTINATION}\", \"${SYSOP_HASH}\"},\n")
    math(EXPR SYSOP_RESOURCE "${SYSOP_RESOURCE} + 1")
    math(EXPR SYSOP_FILES "${SYSOP_FILES} + 1")
endforeach()
# Fresh starter copies and upgrade docs use the same exact19 resource bodies.
string(APPEND SYSOP_ROWS "${STARTER_DOC_ROWS}")
math(EXPR SYSOP_FILES "${SYSOP_FILES} + ${STARTER_DOC_FILES}")
file(WRITE "${OUTPUT_DIRECTORY}/sysop_docs_payload.inc"
    "struct SysopDocAsset { int resource_id; const wchar_t* filename; const char* sha256; };\nconstexpr std::array<SysopDocAsset,${SYSOP_FILES}> sysop_doc_assets{{\n${SYSOP_ROWS}}};\n")
