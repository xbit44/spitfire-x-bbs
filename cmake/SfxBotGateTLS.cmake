# Offline, exact-source, static TLS downloader. No CLI, OS installation or CA search.
set(SFX_CURL_ARCHIVE "${CMAKE_SOURCE_DIR}/third_party/curl/8.22.0/artifacts/curl-8.22.0.tar.xz")
file(SHA256 "${SFX_CURL_ARCHIVE}" SFX_CURL_HASH)
if(NOT SFX_CURL_HASH STREQUAL "f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7")
    message(FATAL_ERROR "Pinned curl archive hash mismatch")
endif()
set(SFX_CA_FILE "${CMAKE_SOURCE_DIR}/third_party/mozilla-ca/2026-11-05/cacert.pem")
file(SHA256 "${SFX_CA_FILE}" SFX_CA_HASH)
if(NOT SFX_CA_HASH STREQUAL "427c064216761a1e72a8b30f0d954d08cb6e4435a82091fb865afd20c8497285")
    message(FATAL_ERROR "Pinned Mozilla CA bundle hash mismatch")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SFX_CA_FILE}" "${SFX_CURL_ARCHIVE}")
set(SFX_CURL_SOURCE "${CMAKE_BINARY_DIR}/third-party/curl/curl-8.22.0")
if(NOT EXISTS "${SFX_CURL_SOURCE}/CMakeLists.txt")
    file(ARCHIVE_EXTRACT INPUT "${SFX_CURL_ARCHIVE}" DESTINATION "${CMAKE_BINARY_DIR}/third-party/curl")
endif()
# Disable upstream's optional environment-selected TLS secret log. The archived
# source stays exact; this one documented integration patch is build-local.
set(SFX_CURL_KEYLOG "${SFX_CURL_SOURCE}/lib/vtls/keylog.c")
file(READ "${SFX_CURL_KEYLOG}" SFX_CURL_KEYLOG_TEXT)
set(SFX_KEYLOG_OLD "keylog_file_name = getenv(\"SSLKEYLOGFILE\");")
set(SFX_KEYLOG_NEW "keylog_file_name = NULL; /* SFX: never emit TLS secrets. */")
string(FIND "${SFX_CURL_KEYLOG_TEXT}" "${SFX_KEYLOG_OLD}" SFX_KEYLOG_AT)
if(NOT SFX_KEYLOG_AT EQUAL -1)
    string(REPLACE "${SFX_KEYLOG_OLD}" "${SFX_KEYLOG_NEW}" SFX_CURL_KEYLOG_TEXT "${SFX_CURL_KEYLOG_TEXT}")
    file(WRITE "${SFX_CURL_KEYLOG}" "${SFX_CURL_KEYLOG_TEXT}")
else()
    string(FIND "${SFX_CURL_KEYLOG_TEXT}" "${SFX_KEYLOG_NEW}" SFX_KEYLOG_AT)
    if(SFX_KEYLOG_AT EQUAL -1)
        message(FATAL_ERROR "curl keylog integration patch no longer matches")
    endif()
endif()
foreach(flag BUILD_CURL_EXE BUILD_SHARED_LIBS BUILD_LIBCURL_DOCS BUILD_MISC_DOCS ENABLE_CURL_MANUAL
    CURL_ENABLE_EXPORT_TARGET CURL_USE_SCHANNEL CURL_WINDOWS_SSPI CURL_CA_NATIVE CURL_CA_FALLBACK
    CURL_USE_LIBPSL CURL_USE_LIBSSH2 CURL_USE_LIBSSH CURL_USE_PKGCONFIG USE_NGHTTP2 USE_LIBIDN2
    CURL_ZLIB CURL_BROTLI CURL_ZSTD ENABLE_UNIX_SOCKETS)
    set(${flag} OFF CACHE BOOL "SFX bounded downloader" FORCE)
endforeach()
foreach(flag BUILD_STATIC_LIBS CURL_STATIC_CRT CURL_USE_OPENSSL HTTP_ONLY ENABLE_THREADED_RESOLVER
    CURL_DISABLE_INSTALL CURL_DISABLE_OPENSSL_AUTO_LOAD_CONFIG CURL_DISABLE_COOKIES CURL_DISABLE_HTTP_AUTH
    CURL_DISABLE_PROXY CURL_DISABLE_NETRC CURL_DISABLE_ALTSVC CURL_DISABLE_HSTS CURL_DISABLE_DOH)
    set(${flag} ON CACHE BOOL "SFX bounded downloader" FORCE)
endforeach()
set(CURL_CA_BUNDLE none CACHE STRING "Only SFX embedded trust" FORCE)
set(CURL_CA_PATH none CACHE STRING "No CA directory lookup" FORCE)
set(CURL_TARGET_WINDOWS_VERSION "0x0601" CACHE STRING "Windows 7 minimum" FORCE)
# Keep project tests; do not configure upstream test programs.
set(SFX_SAVED_BUILD_TESTING ${BUILD_TESTING})
set(BUILD_TESTING OFF)
add_subdirectory("${SFX_CURL_SOURCE}" "${CMAKE_BINARY_DIR}/third-party/curl-build" EXCLUDE_FROM_ALL)
set(BUILD_TESTING ${SFX_SAVED_BUILD_TESTING})
if(WIN32)
    target_compile_definitions(libcurl_static PRIVATE _WIN32_WINNT=0x0601 WINVER=0x0601)
endif()
file(READ "${SFX_CA_FILE}" SFX_CA_HEX HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," SFX_CA_BYTES "${SFX_CA_HEX}")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/botgate")
file(WRITE "${CMAKE_BINARY_DIR}/generated/botgate/botgate_ca.hpp"
    "#pragma once\ninline constexpr unsigned char sfx_botgate_ca[]={${SFX_CA_BYTES}};\ninline constexpr char sfx_botgate_ca_sha256[]=\"${SFX_CA_HASH}\";\n")
add_library(sfx_botgate_https STATIC src/apps/runtime/botgate_https.cpp)
target_include_directories(sfx_botgate_https PUBLIC src/apps/runtime PRIVATE "${CMAKE_BINARY_DIR}/generated/botgate")
target_link_libraries(sfx_botgate_https PRIVATE CURL::libcurl_static OpenSSL::SSL)
if(WIN32)
    target_compile_definitions(sfx_botgate_https PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _WIN32_WINNT=0x0601)
endif()
sfx_configure_portable_target(sfx_botgate_https)
