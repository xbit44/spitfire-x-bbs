set(SFX_DATE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/date/3.0.5")
set(SFX_TZDATA_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/tzdata/2026f")
set(SFX_CLDR_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/third_party/cldr/48")
foreach(root IN ITEMS "${SFX_DATE_ROOT}" "${SFX_TZDATA_ROOT}" "${SFX_CLDR_ROOT}")
    file(READ "${root}/SOURCE.json" manifest)
    string(JSON count LENGTH "${manifest}" files)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${manifest}" files ${index} path)
        string(JSON expected GET "${manifest}" files ${index} sha256)
        file(SHA256 "${root}/${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Pinned timezone input changed: ${path}")
        endif()
    endforeach()
endforeach()
# Compile only the private text-rule reader. No curl, remote API, download,
# install command, host database mutation or process-wide TZ environment use.
add_library(sfx_date_tz STATIC "${SFX_DATE_ROOT}/source/src/tz.cpp")
target_include_directories(sfx_date_tz SYSTEM PUBLIC "${SFX_DATE_ROOT}/source/include")
target_compile_definitions(sfx_date_tz PUBLIC USE_OS_TZDB=0 HAS_REMOTE_API=0 AUTO_DOWNLOAD=0)
target_compile_features(sfx_date_tz PUBLIC cxx_std_17)
target_link_libraries(sfx_date_tz PUBLIC Threads::Threads)
set_target_properties(sfx_date_tz PROPERTIES POSITION_INDEPENDENT_CODE ON)
