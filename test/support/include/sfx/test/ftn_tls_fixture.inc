// Test-only certificate material, generated inside a fresh protected fixture.
struct FtnTestTlsFiles {std::string certificate,key,ca;};
FtnTestTlsFiles ftn_test_tls_files(const std::filesystem::path& root){
    using Key=std::unique_ptr<EVP_PKEY,decltype(&EVP_PKEY_free)>;using Cert=std::unique_ptr<X509,decltype(&X509_free)>;using Bio=std::unique_ptr<BIO,decltype(&BIO_free)>;
    const auto descriptor=ins::mutable_descriptor(ins::operator_sid());ins::create_directory(root,descriptor.get());
    const auto make_key=[](){Key key(EVP_PKEY_Q_keygen(nullptr,nullptr,"EC","prime256v1"),EVP_PKEY_free);check(bool(key),"TLS session fixture key");return key;};
    auto ca_key=make_key(),key=make_key();
    const auto add=[](X509* certificate,X509* issuer,int nid,const char* text){X509V3_CTX context{};X509V3_set_ctx(&context,issuer,certificate,nullptr,nullptr,0);std::unique_ptr<X509_EXTENSION,decltype(&X509_EXTENSION_free)> extension(X509V3_EXT_conf_nid(nullptr,&context,nid,const_cast<char*>(text)),X509_EXTENSION_free);check(extension&&X509_add_ext(certificate,extension.get(),-1)==1,"TLS session fixture extension");};
    const auto make_certificate=[&](EVP_PKEY* public_key,X509* issuer,EVP_PKEY* signer,bool ca){Cert certificate(X509_new(),X509_free);check(certificate&&X509_set_version(certificate.get(),2)==1&&ASN1_INTEGER_set(X509_get_serialNumber(certificate.get()),ca?1:2)==1,"TLS session fixture certificate");check(X509_gmtime_adj(X509_getm_notBefore(certificate.get()),-300)&&X509_gmtime_adj(X509_getm_notAfter(certificate.get()),86400),"TLS session fixture validity");auto* name=X509_get_subject_name(certificate.get());check(X509_NAME_add_entry_by_txt(name,"CN",MBSTRING_ASC,reinterpret_cast<const unsigned char*>(ca?"SFX ISOLATED SESSION TEST CA":"sfx-test.invalid"),-1,-1,0)==1&&X509_set_issuer_name(certificate.get(),issuer?X509_get_subject_name(issuer):name)==1&&X509_set_pubkey(certificate.get(),public_key)==1,"TLS session fixture identity");add(certificate.get(),issuer?issuer:certificate.get(),NID_basic_constraints,ca?"critical,CA:TRUE":"critical,CA:FALSE");add(certificate.get(),issuer?issuer:certificate.get(),NID_key_usage,ca?"critical,keyCertSign,cRLSign":"critical,digitalSignature");if(!ca){add(certificate.get(),issuer,NID_ext_key_usage,"serverAuth");add(certificate.get(),issuer,NID_subject_alt_name,"DNS:sfx-test.invalid");}check(X509_sign(certificate.get(),signer?signer:public_key,EVP_sha256())>0,"TLS session fixture signature");return certificate;};
    auto ca=make_certificate(ca_key.get(),nullptr,nullptr,true),certificate=make_certificate(key.get(),ca.get(),ca_key.get(),false);
    const auto write=[&](const wchar_t* leaf,BIO* bio,bool sensitive){char* bytes{};const auto size=BIO_get_mem_data(bio,&bytes);check(size>0,"TLS session PEM bytes");std::ofstream file(root/leaf,std::ios::binary);file.write(bytes,size);check(file.good(),"TLS session PEM fixture saved");if(sensitive)SecureZeroMemory(bytes,static_cast<std::size_t>(size));};
    {Bio out(BIO_new(BIO_s_mem()),BIO_free);check(out&&PEM_write_bio_X509(out.get(),ca.get())==1,"TLS session CA PEM");write(L"ca.pem",out.get(),false);}
    {Bio out(BIO_new(BIO_s_mem()),BIO_free);check(out&&PEM_write_bio_X509(out.get(),certificate.get())==1,"TLS session server PEM");write(L"server.pem",out.get(),false);}
    {Bio out(BIO_new(BIO_s_mem()),BIO_free);check(out&&PEM_write_bio_PrivateKey(out.get(),key.get(),nullptr,nullptr,0,nullptr,nullptr)==1,"TLS session key PEM");write(L"key.pem",out.get(),true);}
    return {(root/L"server.pem").u8string(),(root/L"key.pem").u8string(),(root/L"ca.pem").u8string()};
}
