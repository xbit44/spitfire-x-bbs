void reader_footer_checks(){
    for(const bool ansi:{false,true})for(const unsigned columns:{2U,3U,8U,20U,40U,80U,132U})for(const bool erase:{false,true})for(const bool mark:{false,true})for(const bool permanent:{false,true}){
        sfx::test::DeterministicInteractiveByteStreamFake bytes;bytes.script_non_secret_text("\r\n");app::StreamCallerTerminal terminal(bytes);terminal.set_text_style(ansi?app::TerminalTextStyle::ogsf_ansi:app::TerminalTextStyle::plain);terminal.set_colors(6,15);
        app::MessageQuestionTerminal framed(terminal,[ansi]{return ansi;},[&](std::string_view value){const auto r=bytes.write_some(value);return r.bytes_written==value.size();});
        app::TerminalDisplayProgram body;if(ansi){body.operations.push_back({app::TerminalDisplayOperationKind::ansi_sequence,"\x1b[0;33;40m"});body.output_byte_count=10;}body.operations.push_back({app::TerminalDisplayOperationKind::cp437_text,"Colored body"});body.operations.push_back({app::TerminalDisplayOperationKind::logical_newline,{}});body.output_byte_count+=14;check(framed.present_display({"message.safe.body",&body})==app::TerminalOutcome::completed,"colored body immediately before generated footer");const auto start=bytes.output().size();
        check(app::present_message_reader_commands(framed,ansi,columns,erase,mark,permanent),"width-aware reader commands render");const auto input=framed.read_key({"message.reader.command",columns<4?"\n":" ",{'N','-','R','L','Q'},'N'});check(input.outcome==app::TerminalOutcome::empty&&input.key=='N',"footer preserves default Enter dispatch through question terminal");
        const auto output=bytes.output().substr(start);check(ansi||output.find('\x1b')==std::string::npos,"plain reader footer is ANSI-free");
        std::vector<std::string> rows(1);std::string compact;unsigned color=6;bool hot{};
        for(std::size_t at=0;at<output.size();){const auto ch=output[at++];if(ch=='\x1b'){check(at<output.size()&&output[at++]=='[',"only trusted SGR in footer");const auto end=output.find('m',at);check(end!=output.npos,"complete footer SGR");const auto sgr=output.substr(at,end-at);if(sgr=="0;37;40"||sgr=="0;37")color=7;else if(sgr=="1;37;40"||sgr=="1;37")color=15;else if(sgr=="0;33;40"||sgr=="0;33")color=6;else if(sgr=="0")color=7;at=end+1;continue;}if(ch=='\r')continue;if(ch=='\n'){rows.emplace_back();continue;}rows.back()+=ch;if(ch==' ')continue;
            if(ch=='['||ch=='<'){if(ansi)check(color==7,"opening reader brackets stay gray");hot=true;}else if(ch==']'||ch=='>'){if(ansi)check(color==7,"closing reader brackets stay gray");hot=false;}else if(ansi)check(color==(hot?15U:7U),"only hotkey tokens are bright white; body color cannot leak");compact+=ch;
        }
        std::string expected="<ENT>Next,[-]Last,[R]Reply,[L]List";if(erase)expected+=",[D]Delete";if(mark)expected+=permanent?",[P]Unprotect":",[P]Protect";expected+=mark?"[Q]Quit:":",[Q]Quit:";check(compact==expected,"all labels punctuation keys and conditional order retained at every width");
        const auto limit=columns-1;for(const auto& row:rows)check(row.size()<=limit,"explicit visible rows leave the terminal right edge unused");
        if(columns>=40){for(const auto& label:{std::string("<ENT> Next"),std::string("[-] Last"),std::string("[R] Reply"),std::string("[L] List"),std::string("[Q] Quit")})check(std::any_of(rows.begin(),rows.end(),[&](const auto& row){return row.find(label)!=row.npos;}),"whole reader option remains together when it fits");if(mark){const std::string label=permanent?"[P] Unprotect":"[P] Protect";check(std::any_of(rows.begin(),rows.end(),[&](const auto& row){return row.find(label)!=row.npos;}),"Permanent label cannot split at normal caller widths");}}
        if(columns>=4)check(std::any_of(rows.begin(),rows.end(),[](const auto& row){return row.size()>=2&&row.substr(row.size()-2)==": ";}),"input suffix stays with rendered colon without wrapper blank row");
    }
}
