void migration17(const std::filesystem::path& root,sfx::test::FakeStoragePathPolicy& paths){
    for(const char* point:{"before-door-requirements-migration","before-door-requirements-migration-commit","after-door-requirements-migration-commit"}){
        auto s=settings(root/point);auto previous=storage::sfx_storage_migrations();previous.resize(16);
        {storage::SqliteStorage old(s,paths,previous);check(old.start().succeeded()&&old.health().schema_version==16,"exact nonempty v16 predecessor");check(old.shutdown().succeeded(),"v16 stopped before upgrade");}
        const auto file=s.data_directory/"SFX.DB";seed(file);auto d=sample_door(1);d.security_level=50;d.sysop_only=true;d.rlogin.protected_credential={10,20,30,40};
        const auto legacy=legacy_storage_door(1,d);
        {internal::SqliteConnection conn(file,SQLITE_OPEN_READWRITE,std::chrono::milliseconds(100),false);
            internal::SqliteStatement insert(conn.get(),"INSERT INTO sfx_door_definitions VALUES(1,?1)","legacy fixture Door");insert.bind(1,legacy);insert.step();
            conn.exec("INSERT INTO sfx_door_menus VALUES(1,'Legacy category'); INSERT INTO sfx_door_entries VALUES(0,7,1,1,'Legacy category',''),(1,42,0,1,'Legacy Door','Keep description');","legacy nonempty menu fixture");}
        s.bootstrap_boundary_hook=[point](std::string_view at){return at==point?app::StorageStatus{app::StorageErrorCode::io,"injected requirements migration fault"}:app::StorageStatus::success();};
        {storage::SqliteStorage failed(s,paths);check(!failed.start(),"requirements migration interruption reported");}
        {internal::SqliteConnection conn(file,SQLITE_OPEN_READONLY,std::chrono::milliseconds(100),false);check(internal::validate_sfx_shipping_database(conn.get(),true),"interrupted requirements migration leaves exact supported schema");check(conn.scalar_int64("PRAGMA user_version","requirements commit boundary")==(std::string_view(point)=="after-door-requirements-migration-commit"?17:16),"requirements migration is atomic");}
        s.bootstrap_boundary_hook={};storage::SqliteStorage retry(s,paths);check(retry.start().succeeded()&&retry.health().schema_version==27,"requirements upgrade retries safely through current schema27");
        const auto c=retry.door_configuration({true,{}});check(c&&c.value&&c.value->menus.size()==2&&c.value->entries.size()==2,"nonempty menu and numbering preserved");
        const auto* restored=app::find_door(*c.value,1);check(restored&&restored->security_level==50&&restored->sysop_only&&restored->execution.level==50&&restored->execution.sysop_only&&restored->rlogin.protected_credential==d.rlogin.protected_credential,"legacy access copied to execution and protected credentials retained");
        check(app::find_door_menu(*c.value,1)->access.level==1&&app::find_door_menu(*c.value,1)->execution.level==1,"old categories preserve previous availability");check(retry.shutdown().succeeded(),"requirements fixture normal shutdown");
        {internal::SqliteConnection conn(file,SQLITE_OPEN_READONLY,std::chrono::milliseconds(100),false);internal::SqliteStatement q(conn.get(),"SELECT definition FROM sfx_door_definitions WHERE door_id=1","unchanged legacy bytes");check(q.row()&&q.blob(0)==legacy,"migration does not rewrite old Door blobs");}
        check(scalar(file,"SELECT count(*) FROM sfx_accounts")==3&&scalar(file,"SELECT count(*) FROM pragma_foreign_key_check")==0,"upgrade preserves accounts and referential integrity");
    }
}
template<class Prepare>void owner_storage_checks(storage::SqliteStorage& db,const app::MessageConfigurationActor& owner,const app::MessageActor& alice,const app::MessageActor& sysop,Prepare prepare,app::DoorConfigurationChange& change){
    const auto current=[&]{return *db.door_configuration(owner).value;};
    prepare();change.door=*app::find_door(current(),1);change.door.execution.level=50;check(db.change_door_configuration(owner,change).succeeded(),"independent execution requirement stored");
    auto shown=db.door_menu(alice,1);check(shown&&shown.value->entries.size()==1,"execution-denied Door remains listed");const auto denied=db.door_launch(alice,{1,42,shown.value->revision});check(!denied&&denied.status.code==app::StorageErrorCode::permission_denied,"direct launch enforces execution requirement");check(db.door_launch(sysop,{1,42,shown.value->revision}).succeeded(),"qualified caller can execute visible Door");
    prepare();change.door=*app::find_door(current(),1);change.door.execution.level=1;check(db.change_door_configuration(owner,change).succeeded(),"restore Door requirement fixture");
    prepare();change.action=app::DoorConfigurationAction::save_menu;change.menu=*app::find_door_menu(current(),1);change.menu.access.level=50;check(db.change_door_configuration(owner,change).succeeded(),"category access rule saved");
    shown=db.door_menu(alice,0);check(shown&&shown.value->entries.empty()&&shown.value->has_hidden_entries,"category access failure hides root entry and suppresses custom artwork");check(!db.door_menu(alice,1)&&!db.door_launch(alice,{1,42,current().revision}),"hidden category cannot be entered or launched by guessed identity");
    prepare();change.action=app::DoorConfigurationAction::save_menu;change.menu=*app::find_door_menu(current(),1);change.menu.access.level=1;change.menu.execution.level=50;check(db.change_door_configuration(owner,change).succeeded(),"category execution rule saved");
    check(db.door_menu(alice,0).value->entries.size()==1,"execution-denied category stays listed");const auto no_entry=db.door_menu(alice,1);check(!no_entry&&no_entry.status.code==app::StorageErrorCode::permission_denied,"category entry returns explicit clearance denial");check(!db.door_launch(alice,{1,42,current().revision}),"execution-denied parent also blocks direct Door launch");
    prepare();change.action=app::DoorConfigurationAction::save_menu;change.menu=*app::find_door_menu(current(),1);change.menu.execution.level=1;check(db.change_door_configuration(owner,change).succeeded(),"restore category requirements");
    for(const unsigned n:{21,31}){prepare();change.action=app::DoorConfigurationAction::save_entry;change.create_only=true;change.entry={0,static_cast<std::uint8_t>(n),app::DoorEntryKind::door,1,"Root shared Door","Keep"};check(db.change_door_configuration(owner,change).succeeded(),"additional ordered placement fixture");}
    prepare();change.action=app::DoorConfigurationAction::save_entry;change.entry={0,7,app::DoorEntryKind::submenu,1,"Games",""};change.order={21,31,7};const auto saved=db.change_door_configuration(owner,change);check(saved.succeeded(),"reorder commits as one owner operation");const auto replay=db.change_door_configuration(owner,change);check(replay&&replay.value->replayed&&replay.value->revision==saved.value->revision,"reorder replay does not permute a second time");
    auto menu=db.door_menu(alice,0);check(menu&&menu.value->entries.size()==3&&menu.value->entries.back().kind==app::DoorEntryKind::submenu&&menu.value->entries.back().number==31,"SQLite caller order matches requested tree order");
    prepare();change.action=app::DoorConfigurationAction::save_entry;change.entry={1,99,app::DoorEntryKind::door,1,"Root shared Door","Keep"};change.create_only=true;change.move_entry=true;change.source_menu=0;change.previous_number=7;
    check(db.change_door_configuration(owner,change).succeeded(),"cross-menu move atomically updates both parents");check(db.door_menu(alice,0).value->entries.size()==2&&db.door_menu(alice,1).value->entries.size()==2,"one placement moved with complete cardinality preserved");
    prepare();change.action=app::DoorConfigurationAction::save_entry;change.entry={0,7,app::DoorEntryKind::door,1,"Root shared Door","Keep"};change.create_only=true;change.move_entry=true;change.source_menu=1;change.previous_number=99;check(db.change_door_configuration(owner,change).succeeded(),"move back preserves original shared definition");
}
