void test_section6_storage(const std::filesystem::path& root) {
    test::FakeStoragePathPolicy path;
    auto fresh=create_ready_storage(root/"fresh",path);
    auto& db=*fresh.database;
    const auto level10=db.security_level(10),level999=db.security_level(999);
    require(level10 && level10.value->minutes_per_call==180U && level10.value->minutes_per_day==180U &&
        level999 && !level999.value->minutes_per_call && !level999.value->minutes_per_day,"fresh 10 defaults 180/180, 999 unlimited");
    require(db.health().schema_version==8,"shipping caller-utilities and additive local-message migrations applied");
    const auto a=create_account(db,"zulu Mellie",50,base_utc+10);
    const auto b=create_account(db,"Alpha Mellie",51,base_utc+11);
    const auto locked=create_account(db,"Hidden",52,base_utc+12);
    require(a && b && locked,"caller directory synthetic accounts created");
    require(db.change_account_state({*locked.account_id,1,app::AccountState::locked,{},audit(53,base_utc+13,app::AuditReasonCode::sysop_action)}).succeeded(),"locked caller excluded");
    app::CallerDirectoryQuery directory;directory.limit=2;
    auto page=db.caller_directory(directory);
    require(page && page.value->size()==2 && (*page.value)[0].name=="Alpha Mellie" && (*page.value)[1].name=="Initial Sysop","public directory case-insensitive alphabetical page");
    directory.offset=2;page=db.caller_directory(directory);
    require(page && page.value->size()==1 && page.value->front().name=="zulu Mellie","directory paging excludes locked caller");
    directory={};directory.name_fragment="MELL";page=db.caller_directory(directory);
    require(page && page.value->size()==2 && page.value->front().location=="Vancouver, BC","case-insensitive partial search returns every public match");
    directory.name_fragment="%";page=db.caller_directory(directory);
    require(page && page.value->empty(),"search metacharacters literal, not SQL wildcard");
    const app::StartSessionRequest first{identifier(55),identifier(155),*a.account_id,1,base_utc+20};
    require(db.record_session_started(first).succeeded(),"authenticated caller time begins on real durable session");
    app::PersistSessionProgressRequest progress{first.session_id,60,base_utc+80,{{"2026-10-01",60}}};
    require(db.persist_session_progress(progress).succeeded() && db.persist_session_progress(progress).succeeded(),"daily progress retry idempotent");
    require(db.caller_day_seconds(*a.account_id,"2026-10-01").value==60 && db.find_account_by_id(*a.account_id).value->statistics.authenticated_session_seconds==60,"daily and lifetime totals charge once");
    progress={first.session_id,80,base_utc+100,{{"2026-10-01",65},{"2026-10-02",15}}};
    require(db.persist_session_progress(progress).succeeded() && db.caller_day_seconds(*a.account_id,"2026-10-02").value==15,"midnight split charged on its real local days");
    auto invalid_progress=progress;invalid_progress.daily_seconds={{"2026-10-01",64},{"2026-10-02",16}};
    require(!db.persist_session_progress(invalid_progress) && db.caller_day_seconds(*a.account_id,"2026-10-02").value==15,"committed earlier day cannot be reduced/reallocated");
    invalid_progress.daily_seconds={{"2026-10-02",80}};
    require(!db.persist_session_progress(invalid_progress),"committed earlier day cannot disappear");
    invalid_progress.daily_seconds={{"2026-10-01",65},{"2026-10-02",20}};
    require(!db.persist_session_progress(invalid_progress),"day sum must equal cumulative session total");
    const app::FinalizeSessionRequest finished{first.session_id,83,base_utc+101,app::SessionOutcomeCode::normal,identifier(56),{{"2026-10-01",65},{"2026-10-02",18}}};
    require(db.finalize_session(finished).succeeded() && db.finalize_session(finished).replayed,"completion retry cannot double-count progress");
    require(db.find_account_by_id(*a.account_id).value->statistics.authenticated_session_seconds==83 && db.caller_day_seconds(*a.account_id,"2026-10-02").value==18,"completion atomically commits final uncheckpointed seconds and daily totals");
    const app::StartSessionRequest second{identifier(57),identifier(157),*a.account_id,2,base_utc+200};
    require(db.record_session_started(second).succeeded(),"reconnect begins separate durable call");
    progress={second.session_id,10,base_utc+210,{{"2026-10-02",10}}};
    require(db.persist_session_progress(progress).succeeded(),"short completed call accounting does not wait 60 seconds");
    require(db.shutdown().succeeded() && db.start().succeeded(),"daily accounting survives real database reopen");
    require(db.caller_day_seconds(*a.account_id,"2026-10-02").value==28,"restart does not charge Runtime downtime");
    require(db.finalize_session({second.session_id,10,base_utc+10000,app::SessionOutcomeCode::runtime_error,identifier(58)}).succeeded(),"unfinished recovered session uses last durable elapsed, never wall-clock downtime");
    require(db.caller_day_seconds(*a.account_id,"2026-10-02").value==28 && db.find_account_by_id(*a.account_id).value->statistics.authenticated_session_seconds==93,"recovery totals remain exact");
    directory={};directory.logon_utc_range={{base_utc+19,base_utc+250}};page=db.caller_directory(directory);
    require(page && page.value->size()==1 && page.value->front().last_logon_utc==base_utc+200,"today/yesterday storage groups successful calls once at most recent logon in selected day");
    directory.logon_utc_range={{base_utc+19,base_utc+30}};page=db.caller_directory(directory);
    require(page && page.value->size()==1 && page.value->front().last_logon_utc==base_utc+20,"selected day uses most recent logon within day, not global latest");
    app::HistoryQuery history;history.account_id=*a.account_id;history.limit=1;
    auto calls=db.session_history(history);history.offset=1;auto older=db.session_history(history);
    require(calls && older && calls.value->front().session_id==second.session_id && older.value->front().session_id==first.session_id,"history pages individual calls without collapsing directory duplicates");
    history.offset=0;history.after_session={{calls.value->front().started_utc_seconds,calls.value->front().session_id}};
    const app::StartSessionRequest concurrent{identifier(95),identifier(195),*a.account_id,3,base_utc+201};
    require(db.record_session_started(concurrent).succeeded(),"new call inserted while history page is open");
    older=db.session_history(history);
    require(older && older.value->size()==1 && older.value->front().session_id==first.session_id,"stable history cursor does not repeat an old page when another permitted call arrives");
    require(db.finalize_session({concurrent.session_id,0,base_utc+202,app::SessionOutcomeCode::normal,identifier(96)}).succeeded(),"concurrent history fixture completed");
    auto account=db.find_account_by_id(*b.account_id);auto changed=account.value->profile;changed.location="Approved public place";
    app::UpdateProfileRequest self{*b.account_id,account.value->revision,changed,audit(59,base_utc+300,app::AuditReasonCode::caller_action,*b.account_id)};
    require(db.update_profile(self).succeeded(),"self profile update audited with caller actor/reason");
    require(!db.update_profile(self),"stale caller cannot overwrite concurrent account edit");
    self.expected_revision++;self.profile.birth_date="1990-01-01";self.audit.event_id=identifier(60);
    require(!db.update_profile(self),"DOB caller edit refused inside writer transaction");
    self.profile=changed;self.audit.actor_account_id=*a.account_id;
    require(!db.update_profile(self),"self edit cannot attribute another actor identity");
    const auto audits=db.audit_history({*b.account_id,app::AuditEventKind::account_profile_changed,app::kMaximumUtcSeconds,10});
    require(audits && audits.value->size()==1 && audits.value->front().reason==app::AuditReasonCode::caller_action && audits.value->front().actor_account_id==b.account_id,"only committed self update produces private-free typed audit");
    auto catalog=db.security_levels();auto policy=db.security_policy();
    app::PublishSecurityPolicyRequest update;update.expected_revision=policy.value->revision;update.levels=*catalog.value;
    update.levels.front().minutes_per_call=std::uint32_t{60};update.levels.front().minutes_per_day=std::uint32_t{180};
    update.new_user_level=10;update.sysop_threshold=999;update.policy_hash=policy.value->policy_hash;update.published_policy_hash=policy.value->policy_hash;
    update.audit=audit(61,base_utc+400,app::AuditReasonCode::security_policy);
    require(db.publish_security_policy(update).succeeded() && db.security_level(10).value->minutes_per_call==60U && db.security_level(10).value->minutes_per_day==180U,"per-call and daily limits independently save through protected catalog transaction");
    require(db.shutdown().succeeded() && db.start().succeeded() && db.security_level(10).value->minutes_per_call==60U,"configured limits survive reopen, never reseeded");
    require(db.shutdown().succeeded(),"fresh Section6 storage stopped");
    auto old_migrations=storage::sfx_storage_migrations();old_migrations.resize(3);
    auto legacy=create_ready_storage(root/"legacy",path,2,old_migrations);
    const auto old_account=create_account(*legacy.database,"Preserved Legacy",70,base_utc+20);
    require(old_account && legacy.database->shutdown().succeeded(),"genuine completed v3 account baseline retained");
    auto interrupted_options=settings_for(root/"legacy");
    interrupted_options.bootstrap_boundary_hook=[](std::string_view point) {
        return point=="before-caller-utilities-migration-commit"?app::StorageStatus{app::StorageErrorCode::io,"synthetic Section6 migration interruption"}:app::StorageStatus::success();
    };
    {storage::SqliteStorage interrupted(interrupted_options,path);require(!interrupted.start(),"new migration interrupted before commit");}
    require(legacy.database->start().succeeded() && legacy.database->health().schema_version==3 &&
        legacy.database->find_account_by_id(*old_account.account_id).value->display_name=="Preserved Legacy","interruption preserves exact usable v3 schema audit ledger and account identity");
    require(legacy.database->shutdown().succeeded(),"legacy retry proof stopped before real upgrade");
    storage::SqliteStorage upgrade(settings_for(root/"legacy"),path);
    require(upgrade.start().succeeded() && upgrade.health().schema_version==8,"completed v3 migrates through accepted lineage and additive v8");
    require(!upgrade.security_level(10).value->minutes_per_call && !upgrade.security_level(10).value->minutes_per_day,"existing unlimited installation not silently limited on upgrade");
    require(upgrade.find_account_by_id(*old_account.account_id).value->display_name=="Preserved Legacy" && upgrade.find_account_by_id(legacy.sysop_id).value->profile.birth_date=="1980-02-29","upgrade preserves authoritative identity and private profile");
    require(upgrade.shutdown().succeeded(),"upgraded legacy fixture stopped");
}
