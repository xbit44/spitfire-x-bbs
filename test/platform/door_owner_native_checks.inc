void select_list(HWND window,LPARAM value){
    wchar_t cls[64]{};GetClassNameW(window,cls,64);if(_wcsicmp(cls,WC_TREEVIEWW)){retained_fixture_list(window,value);return;}
    DWORD_PTR context{};check(GetWindowSubclass(window,door_tree_keys,83,&context)!=FALSE,"native tree subclass");auto& s=*reinterpret_cast<State*>(context);
    for(std::size_t i=0;i<s.doors.tree_items.size();++i){const auto node=s.doors.tree_items[i];if(!node.group&&node.entry.kind==app::DoorEntryKind::submenu&&node.entry.target==value){TreeView_SelectItem(window,node.handle);return;}door_tree_expand(s,node.handle);}
    throw std::runtime_error("named tree category missing");
}
void category(State& s,unsigned id){door_show_view(s,DoorPage::categories);remember_page(s);select_list(s.doors.categories,id);press(s,IDC_DOOR_OPEN);}
void open_entry(State& s,unsigned n){select_list(s.doors.entries,n);press(s,IDC_DOOR_EDIT);}
DoorEditorState::TreeItem owner_node(State& s,app::DoorEntryKind kind,unsigned target){
    for(std::size_t i=0;i<s.doors.tree_items.size();++i){const auto node=s.doors.tree_items[i];if(!node.group&&node.entry.kind==kind&&node.entry.target==target)return node;door_tree_expand(s,node.handle);}
    throw std::runtime_error("tree entry absent");
}
void owner_key(HWND window,unsigned key,bool shift=false){
    BYTE previous[256]{},keys[256]{};check(GetKeyboardState(previous)!=FALSE,"capture thread keyboard state");std::copy(std::begin(previous),std::end(previous),std::begin(keys));keys[VK_CONTROL]=0x80;keys[VK_SHIFT]=shift?0x80:0;
    check(SetKeyboardState(keys)!=FALSE,"owned thread shortcut modifier");SendMessageW(window,WM_KEYDOWN,key,0);check(SetKeyboardState(previous)!=FALSE,"restore thread keyboard state");
}
void owner_toggle(HWND tree,HTREEITEM item){
    TreeView_EnsureVisible(tree,item);RECT row{};check(TreeView_GetItemRect(tree,item,&row,TRUE)!=FALSE,"visible native expand button row");
    const int y=(row.top+row.bottom)/2;int button=-1;
    for(int x=0;x<row.left;++x){TVHITTESTINFO hit{};hit.pt={x,y};if(TreeView_HitTest(tree,&hit)==item&&(hit.flags&TVHT_ONITEMBUTTON)){button=x;break;}}
    check(button>=0,"native plus/minus hit target");SendMessageW(tree,WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(button,y));SendMessageW(tree,WM_LBUTTONUP,0,MAKELPARAM(button,y));
}
