void group_checks(storage::SqliteStorage& db,const std::filesystem::path& root,const std::shared_ptr<native::LinuxFilePayloadBindings>& bindings){
    namespace fs=std::filesystem;const app::FileConfigurationActor owner{true,{}};
    native::LinuxFileConfigurationPaths paths(root,bindings,true),online(root,bindings,false);
    app::LocalFileAdministration admin(db,app::LocalAccountAuthority::installation_owner,&paths),live(db,app::LocalAccountAuthority::installation_owner,&online);
    const auto config=[&]{const auto value=db.file_configuration(owner);check(value&&value.value,"group current configuration");return *value.value;};
    const auto group=[&](std::string name){app::FileConfigurationChange edit;edit.operation=id(operations++);edit.action=app::FileConfigurationAction::group;edit.expected_catalog_revision=config().policy.catalog_revision;edit.group.name=std::move(name);const auto made=admin.execute(edit);check(made.code==app::LocalAccountResultCode::ok,"create group");return app::FileGroupId{made.result.identity};};
    const auto area=[&](app::FileGroupId g,std::string name){check(fs::create_directory(root/"Files"/name)&&chmod((root/"Files"/name).c_str(),0700)==0,"new group fixture directory");app::FileConfigurationChange edit;edit.operation=id(operations++);edit.action=app::FileConfigurationAction::area;edit.expected_catalog_revision=config().policy.catalog_revision;edit.area.area.group=g;edit.area.area.name=name;edit.area.storage_path="Files/"+name;const auto made=admin.execute(edit);check(made.code==app::LocalAccountResultCode::ok,"create area");return app::FileAreaId{made.result.identity};};
    const auto erase=[&](app::FileGroupId g,bool disk,bool preview=false){const auto current=config();app::FileConfigurationChange edit;edit.operation=id(operations++);edit.expected_catalog_revision=current.policy.catalog_revision;edit.action=preview?app::FileConfigurationAction::preview_group_delete:app::FileConfigurationAction::begin_group_delete;edit.group=*std::find_if(current.groups.begin(),current.groups.end(),[&](const auto& value){return value.id==g;});edit.delete_disk_files=disk;return edit;};
    const auto write=[&](std::string folder,std::string name){auto directory=native::FilePayloadDirectory::private_store(root/"Files"/folder,bindings);auto file=directory.create(name,100);const std::string bytes="reviewed group payload "+name;file.append(reinterpret_cast<const std::uint8_t*>(bytes.data()),bytes.size());return file.identity();};
    native::LinuxFileManager manager(db,owner,root,bindings);
    const auto import=[&](app::FileAreaId a,std::string folder,std::string name){native::NativeFileImportChoice choice;choice.operation=id(operations++);choice.area=a;choice.source=root/"Files"/folder/name;choice.mode=app::FileImportMode::in_place;choice.allow_duplicate_content=true;const auto preview=manager.preview_import(choice);check(preview.has_value(),"review group import");const auto done=manager.import_file(*preview);check(done.completed,"register group file");return done.result;};
    const auto kept=group("Keep disk files");const auto kept_area=area(kept,"KeepFixture");write("KeepFixture","registered.txt");import(kept_area,"KeepFixture","registered.txt");write("KeepFixture","loose.txt");
    const auto revision=config().policy.catalog_revision;const auto count=admin.execute(erase(kept,false,true));check(count.code==app::LocalAccountResultCode::ok&&count.area_count==1&&count.catalog_files==1&&count.disk_files==2&&config().policy.catalog_revision==revision,"group preview counts without mutation");
    auto removal=erase(kept,false);check(live.execute(removal).code==app::LocalAccountResultCode::policy_rejected,"live group deletion refused");check(admin.execute(removal).code==app::LocalAccountResultCode::ok&&admin.execute(removal).code==app::LocalAccountResultCode::ok,"keep-files deletion and replay");check(fs::exists(root/"Files/KeepFixture/registered.txt")&&fs::exists(root/"Files/KeepFixture/loose.txt"),"both registered and loose kept bytes survive");
    const auto deleted=group("Delete disk files");const auto deleted_area=area(deleted,"DeleteFixture");write("DeleteFixture","registered.txt");import(deleted_area,"DeleteFixture","registered.txt");write("DeleteFixture","loose.txt");
    check(fs::create_directory(root/"Files/DeleteFixture/nested")&&chmod((root/"Files/DeleteFixture/nested").c_str(),0700)==0,"nested refusal fixture");
    check(admin.execute(erase(deleted,true)).code!=app::LocalAccountResultCode::ok&&!db.file_group_deletion(owner,deleted)&&fs::exists(root/"Files/DeleteFixture/registered.txt"),"nested folder refuses entire disk plan without deletion");check(fs::remove(root/"Files/DeleteFixture/nested"),"remove empty owned nested fixture");
    fs::create_symlink("registered.txt",root/"Files/DeleteFixture/link.txt");check(admin.execute(erase(deleted,true)).code!=app::LocalAccountResultCode::ok&&!db.file_group_deletion(owner,deleted),"symlink refuses disk plan");check(fs::remove(root/"Files/DeleteFixture/link.txt"),"remove owned symlink fixture only");
    fs::create_hard_link(root/"Files/DeleteFixture/registered.txt",root/"Files/DeleteFixture/alias.txt");check(admin.execute(erase(deleted,true)).code!=app::LocalAccountResultCode::ok&&!db.file_group_deletion(owner,deleted),"hardlink refuses disk plan");check(fs::remove(root/"Files/DeleteFixture/alias.txt"),"remove owned hardlink injector");
    unsigned boundaries{};native::LinuxFileConfigurationPaths interrupted(root,bindings,true,[&](auto point){if(point==native::FileGroupDeletionBoundary::file_deleted&&++boundaries==1)throw std::runtime_error("owned interruption");});app::LocalFileAdministration faulty(db,app::LocalAccountAuthority::installation_owner,&interrupted);
    removal=erase(deleted,true);check(faulty.execute(removal).code!=app::LocalAccountResultCode::ok,"partial group deletion never claims completion");const auto journal=db.file_group_deletion(owner,deleted);check(journal&&journal.value&&!journal.value->completed&&journal.value->items.size()==2,"exact two-item deletion intent retained");
    check(db.shutdown().succeeded()&&db.start().succeeded(),"group deletion survives database restart");write("DeleteFixture","arrived-later.txt");check(admin.execute(removal).code!=app::LocalAccountResultCode::ok&&fs::exists(root/"Files/DeleteFixture/arrived-later.txt"),"new unreviewed file survives resume and keeps group pending");
    {auto directory=native::FilePayloadDirectory::private_store(root/"Files/DeleteFixture",bindings);auto new_file=directory.read("arrived-later.txt",true);new_file.rename_to(native::FilePayloadDirectory::private_store(root/"Data/FileRemoved",bindings),"unreviewed-preserved.txt");}
    check(admin.execute(removal).code==app::LocalAccountResultCode::ok&&fs::is_empty(root/"Files/DeleteFixture")&&db.file_group_deletion(owner,deleted).value->completed,"continue exact reviewed plan and retire group");
    check(fs::exists(root/"Data/FileRemoved/unreviewed-preserved.txt")&&fs::exists(root/"Files/KeepFixture/registered.txt"),"unreviewed and kept group files remain untouched");check(admin.execute(erase({1},false)).detail.find("required")!=std::string::npos,"required upload areas protect system group");
}
