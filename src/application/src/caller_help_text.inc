{static_cast<int>(MenuId::main), 'M', "Message Menu", "Read and write messages on the BBS. You can browse public discussions, send private local mail, and read messages addressed to you."},
{static_cast<int>(MenuId::main), 'F', "File Menu", "Browse files available on the BBS, download files to your computer, or upload files to share with other callers."},
{static_cast<int>(MenuId::main), 'D', "Door Menu", "Doors are games or other programs you can use through the BBS. Open the Door Menu to choose a game or program you would like to use."},
{static_cast<int>(MenuId::main), 'B', "Bulletins", "Read notices and information posted by the Sysop. Choose a bulletin number to read it, or check which bulletins have changed since your last logon."},
{static_cast<int>(MenuId::main), 'C', "Chat Menu", "Open the Chat Menu. E enters your current room, initially the Lobby. L lists rooms and lets you change your selection. W shows Who's Online; T sends private online text."},
{static_cast<int>(MenuId::main), 'S', "Comment to Sysop", "Send a private message to the Sysop. Use this for questions, feedback, or reporting a problem with the BBS. It is a message, not a live chat request."},
{static_cast<int>(MenuId::main), 'L', "Locate a Caller", "Search the BBS caller directory by name. This looks for a caller's account; it does not mean the caller is online right now."},
{static_cast<int>(MenuId::main), '#', "List all Callers", "View the BBS caller directory. You can show all listed callers or narrow the list to callers who logged on today or yesterday."},
{static_cast<int>(MenuId::main), 'W', "Who's On-line", "See who is connected to the BBS right now and which node each caller is using. This is an online list, not the full caller directory."},
{static_cast<int>(MenuId::main), 'P', "Page Sysop", "Ask the Sysop for attention while you are online. If the Sysop cannot answer, use Comment to Sysop to leave a private message instead."},
{static_cast<int>(MenuId::main), 'Y', "Your Info / Settings", "View and update your caller information and preferences, such as your password, display color, and hot-key mode."},
{static_cast<int>(MenuId::main), 'N', "BBS Newsletter", "Read the Sysop's newsletter for BBS news and updates. If no newsletter is available, the BBS will tell you there is no news to report."},
{static_cast<int>(MenuId::main), '?', "System Help", "Choose a Main Menu command to learn what it does. Help explains your choice without running it. Press Enter afterward to return to the Main Menu."},
{static_cast<int>(MenuId::main), 'O', "Other Bulletin Boards", "Browse a list of other BBSes and their connection information. You can also submit a board to the list. Viewing an entry does not connect you to that BBS."},
{static_cast<int>(MenuId::main), 'I', "This System's Info", "Read information about this BBS, including its opening date and available system activity totals."},
{static_cast<int>(MenuId::main), 'G', "Goodbye / Logoff", "End your visit to the BBS. SFX asks you to confirm before logging you off."},
{static_cast<int>(MenuId::main), '/', "Quick Goodbye / Logoff", "Log off immediately without the normal confirmation or goodbye screen. Use this only when you are ready to disconnect."},
{static_cast<int>(MenuId::main), '@', "Sysop Utilities", "Open the BBS administration options available to authorized Sysops."},
{static_cast<int>(MenuId::messages), 'L', "QWK / Offline Mail", "Offline mail lets you download messages to read away from the BBS and upload replies later."},
{static_cast<int>(MenuId::qwk), 'D', "Download QWK Packet", "Download a ZIP-format QWK packet over ZMODEM using your saved packet and shared message-scan settings. Only a successfully completed download advances public progress or marks included received private mail Read. More messages may require another packet."},
{static_cast<int>(MenuId::qwk), 'U', "Upload REP Packet", "Upload one ZIP-format REP reply packet over ZMODEM. SFX validates the whole packet before posting any messages or applying ADD/DROP commands. The packet must belong to this BBS. Exact accepted retries are not posted again. Maximum compressed size is 16 MiB and actual expanded contents are limited to 64 MiB."},
{static_cast<int>(MenuId::qwk), 'S', "Packet Settings", "Save your own private-mail inclusion, own-public-post, supported encoding, colors/artwork, word-wrap, index and full-header choices. ZIP and ZMODEM are fixed. UTF-8, when available, requires full headers. Sent mail and another caller's Inbox are never included."},
{static_cast<int>(MenuId::qwk), 'A', "Message Scan Settings", "Choose the same public-echo Unread/To-you selections used by online scans. QWK does not maintain a separate subscription list. Private received-mail inclusion is controlled by Packet Settings."},
{static_cast<int>(MenuId::qwk), 'P', "New-message Pointers", "Rescan all available public messages, messages entered since a chosen BBS-local date/time, or mark public progress caught up. Choose one echo, one group or all accessible groups. Bulk changes require confirmation. This does not change private-mail Read state or scan selections."},
{static_cast<int>(MenuId::qwk), '?', "Help", "Choose a QWK / Offline Mail Menu command to learn what it does. Press Enter after the explanation to return to this menu."},
{static_cast<int>(MenuId::qwk), 'Q', "Return to Message Menu", "Leave QWK / Offline Mail and return to the Message Menu. This does not return to Main or log you off."},
{static_cast<int>(MenuId::messages), 'C', "Change Conference", "Choose a group and accessible conference. After a successful save, Read now defaults Yes and enters This Conference directly. Declining Read keeps the new selection; cancelling the picker keeps the old one. Leaving the reader returns to Message Menu."},
{static_cast<int>(MenuId::messages), 'R', "Read Messages", "Choose This Conference, All, Only Queued, New Message Scan or Return. Enter resumes the saved available message in This Conference. L List shows numbered headers. On an eligible row, D deletes or restores it. In plain mode use D and the row number, such as D 12. Queued uses Unread OR To-you. Q ends the reading run at Message Menu."},
{static_cast<int>(MenuId::messages), 'Y', "Your Message Scan", "Review your summary. Reading defaults to T To You. L List defaults to Both and includes Private Inbox and Sent Private/NetMail. Q in the List chooser returns to Message Menu. D on an eligible Inbox row can remove or restore your own copy. When a Y Door is available, its separate chooser offers Y Scan, D Door or Q Return."},
{static_cast<int>(MenuId::messages), 'B', "Browse Messages", "Browse This Conference, All or Queued. Up and Down move one row across pages. PgUp/PgDn move a full page. The list stops at its ends. D deletes or restores an eligible row. A star marks a deleted row. In plain mode use D and the displayed row number, such as D 12. After reading, Enter or L restores the same page and row. K skips a conference in All/Queued. Q returns to Message Menu."},
{static_cast<int>(MenuId::messages), 'S', "Specific Caller Messages", "Choose This Conference, All or Queued. Choose L Local caller or H FTN/header name and confirm the match. Choose To, From or Both (default). Readable public results use the Browse controls, including D on eligible rows. Enter or L after reading returns to the same page and row. Next and Previous stay among matches."},
{static_cast<int>(MenuId::messages), 'E', "Enter a Message", "Write a public post in your current conference or send private local mail to a caller by name. You need posting access for a public post. Choose private local mail when the message is not intended for the public discussion."},
{static_cast<int>(MenuId::messages), 'A', "Message Scan Settings", "Unread and To-you are separate saved flags for each accessible public conference; both default On if unset. Each individual toggle saves immediately. Group-wide column changes require confirmation, default No. These flags do not change reading/posting permissions or received state. Q backs through groups to the opening menu."},
{static_cast<int>(MenuId::messages), 'T', "Search Messages", "Choose This Conference, All or Queued. Enter a literal Subject or body phrase up to 128 characters. Results use Browse controls, including D on eligible rows. Enter or L after reading returns to the same page and row. Next and Previous stay among matches. Q returns to Message Menu."},
{static_cast<int>(MenuId::messages), 'F', "File Menu", "Switch to the File Menu to browse, download, or upload files."},
{static_cast<int>(MenuId::messages), 'W', "Who's On-line", "See which callers are connected to the BBS right now."},
{static_cast<int>(MenuId::messages), '?', "Help", "Choose a Message Menu command to learn what it does. Press Enter after the explanation to return to the Message Menu."},
{static_cast<int>(MenuId::messages), 'Q', "Main Menu", "Leave the Message Menu and return to the Main Menu. This does not log you off."},
{static_cast<int>(MenuId::messages), 'G', "Goodbye / Logoff", "End your visit to the BBS after confirming that you want to log off."},
{static_cast<int>(MenuId::messages), '/', "Quick Goodbye / Logoff", "Log off immediately without the normal confirmation or goodbye screen."},
{static_cast<int>(MenuId::files), 'C', "Change File Area", "Choose a File Group and File Area to browse. File Areas organize files by subject or purpose; the current area is shown below the File Menu."},
{static_cast<int>(MenuId::files), 'L', "List Files", "Show the filenames and descriptions in the current File Area."},
{static_cast<int>(MenuId::files), 'N', "New File Scan", "Find newly added files in the areas included in your file scan."},
{static_cast<int>(MenuId::files), 'F', "Find Filename", "Look for a file by its filename."},
{static_cast<int>(MenuId::files), 'T', "Search Descriptions", "Find files by searching their descriptions. Use this when you know what a file is about but not its filename."},
{static_cast<int>(MenuId::files), 'R', "Read Text File", "Read a supported text file online without downloading it first."},
{static_cast<int>(MenuId::files), 'V', "View Archive", "See the contents of a supported archive, such as a ZIP file, without downloading the whole archive first."},
{static_cast<int>(MenuId::files), 'D', "Download Files", "Download tagged files or enter a filename, partial name or wildcard to add selections. Confirm before starting. Files not completed remain queued."},
{static_cast<int>(MenuId::files), 'B', "Batch Transfer Menu", "Open the Batch Transfer Menu to upload or download queued files, review both queues, remove entries, or clear the queues."},
{static_cast<int>(MenuId::files), 'U', "Upload Files", "Enter a filename to upload to the current permitted File Area. Add another file if needed, then start the upload or leave it queued. Select the actual local files in your terminal; entering a name here does not select them on your computer."},
{static_cast<int>(MenuId::files), 'S', "Upload to Sysop", "Start a separate private submission to the Sysop. Your ordinary upload queue and its destinations remain unchanged."},
{static_cast<int>(MenuId::files), 'W', "Who's On-line", "See which callers are connected to the BBS right now."},
{static_cast<int>(MenuId::files), '?', "Help", "Choose a File Menu command to learn what it does. Press Enter after the explanation to return to the File Menu."},
{static_cast<int>(MenuId::files), 'M', "Message Menu", "Switch to the Message Menu to read or write messages."},
{static_cast<int>(MenuId::files), 'Q', "Main Menu", "Leave the File Menu and return to the Main Menu without logging off."},
{static_cast<int>(MenuId::files), 'G', "Goodbye / Logoff", "End your visit to the BBS after confirming that you want to log off."},
{static_cast<int>(MenuId::files), '/', "Quick Goodbye / Logoff", "Log off immediately without the normal confirmation or goodbye screen."},
{static_cast<int>(MenuId::chat), 'E', "Enter Chat Room", "Enter the Current Chat Room shown below the menu. L lets you change that selection. Use /Q inside the room to return to the Chat Menu."},
{static_cast<int>(MenuId::chat), 'L', "List / Change Chat Rooms", "List the rooms available to you and choose a room number. Your choice is remembered for this call. Return to the Chat Menu and press E to enter it. Enter cancels without changing your choice."},
{static_cast<int>(MenuId::chat), 'W', "Who's On-line", "See which callers are connected to the BBS right now. This does not start a chat."},
{static_cast<int>(MenuId::chat), 'T', "Private Online Text", "Send a short private text to a caller who is online. Unlike private local mail, online text is intended for an active conversation."},
{static_cast<int>(MenuId::chat), 'B', "Block / Ignore", "Manage callers you do not want to receive ordinary chat or online texts from."},
{static_cast<int>(MenuId::chat), 'U', "uMRC Chat", "Join live conversations through the uMRC chat option."},
{static_cast<int>(MenuId::chat), '?', "System Help", "Choose a Chat Menu command to learn what it does. Press Enter after the explanation to return to the Chat Menu."},
{static_cast<int>(MenuId::chat), 'Q', "Main Menu", "Leave the Chat Menu and return to the Main Menu without logging off."},
{static_cast<int>(MenuId::chat), 'G', "Goodbye / Logoff", "End your visit to the BBS after confirming that you want to log off."},
{static_cast<int>(MenuId::chat), '/', "Quick Goodbye / Logoff", "Use /G to disconnect immediately without confirmation or the goodbye display."},
{static_cast<int>(MenuId::settings), 'P', "Change Password", "Change the password for your BBS account. Enter your current password, then enter your new password twice. Your new password must meet this BBS's rules."},
{static_cast<int>(MenuId::settings), 'G', "Graphics", "Switch this connection between ANSI graphics and plain ASCII display. Use ASCII if your terminal does not display ANSI screens correctly."},
{static_cast<int>(MenuId::settings), 'F', "File Transfer", "Choose your preferred file-transfer protocol, or choose to select one at each transfer. This saves a preference; it does not start a transfer."},
{static_cast<int>(MenuId::settings), 'H', "Hot-Key Mode", "Turn hot-key mode on or off. When it is on, ordinary menu commands run as soon as you press their key. When it is off, type the command and press Enter."},
{static_cast<int>(MenuId::settings), 'S', "Scan Preferences", "Choose your File Scan Areas, logon New File Scan, earlier scan date, and File light-bar preference. To select conferences for message scans, use Message Menu A."},
{static_cast<int>(MenuId::settings), 'C', "Change Color", "Choose the color used for your ordinary BBS text, or use the BBS default. Authored ANSI artwork and fixed warning colors are not recolored."},
{static_cast<int>(MenuId::settings), 'N', "Node Chat Availability", "Choose whether other callers can request a private node chat with you."},
{static_cast<int>(MenuId::settings), 'L', "Logon / Logoff Notices", "Choose whether you receive notices when other callers arrive or leave."},
{static_cast<int>(MenuId::settings), 'E', "Edit Caller Profile", "View your account information and edit the profile fields this BBS allows you to change. You can also review your own call history."},
{static_cast<int>(MenuId::settings), '?', "System Help", "Choose a settings command to learn what it does. Reading help does not change a preference. Press Enter afterward to return to Your Info / Settings."},
{static_cast<int>(MenuId::settings), 'Q', "Main Menu", "Leave Your Info / Settings and return to the Main Menu without logging off."},
{static_cast<int>(MenuId::batch_transfer), 'A', "Add files to a queue", "Choose the upload or download queue, then add filenames. Adding here does not start a transfer."},
{static_cast<int>(MenuId::batch_transfer), 'U', "Upload files in upload queue", "Send the files waiting in your upload queue from your computer to the BBS."},
{static_cast<int>(MenuId::batch_transfer), 'D', "Download files in download queue", "Receive the files waiting in your download queue from the BBS onto your computer."},
{static_cast<int>(MenuId::batch_transfer), 'L', "List files in batch queues", "Review the files waiting in your upload and download queues."},
{static_cast<int>(MenuId::batch_transfer), 'R', "Remove files from batch queues", "Remove selected entries from your upload or download queue. This does not delete files from your computer or the BBS."},
{static_cast<int>(MenuId::batch_transfer), 'C', "Clear all batch queues", "Empty both your upload and download queues. This does not delete the files themselves."},
{static_cast<int>(MenuId::batch_transfer), 'Q', "Return to File Menu", "Return to the File Menu without logging off or clearing either queue. Use Remove or Clear to discard queued entries explicitly."},
{static_cast<int>(MenuId::batch_transfer), '?', "Help", "Choose a Batch Transfer command to learn what it does. Press Enter after the explanation to return to the Batch Transfer Menu."},
