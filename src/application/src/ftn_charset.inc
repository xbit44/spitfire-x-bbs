            if((cp>=0x0300&&cp<=0x036f)||cp==0x200b||cp==0x200c||cp==0x200d||cp==0xfeff)continue;
        }else cp=(*table)[cp-128];
        out+=ftn_display_glyph(cp);
    }
    return out;
}
}
