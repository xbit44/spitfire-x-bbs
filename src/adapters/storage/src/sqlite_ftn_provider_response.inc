// This bounded first-test profile records authenticated, exactly correlated
// responses. No provider-specific success grammar has been qualified; body
// words, transport GOT, and a remote display name never prove subscription.
application::StorageResult<application::FtnImportResult> SqliteAccountRepository::record_ftn_provider_response(const application::MessageConfigurationActor& a,const application::FtnImportRequest& r){
    namespace app=application;using Result=app::FtnImportResult;
    if(!ftn_work_detail::owner(a)||!r.operation.valid()||!r.ingress.valid()||r.message_index>=4096||r.expected_configuration_revision<1||!app::valid_ftn_code(r.network)||!r.forwarding.empty()||std::any_of(r.header.password.begin(),r.header.password.end(),[](auto ch){return ch!=0;}))return read_failure<Result>(invalid("validate native provider response context"));
    const auto meta=app::inspect_ftn_message(r.header,r.message);if(!meta||!meta->area.empty()||meta->reply.empty()||(!ftn_detail::same(r.message.to,"AreaFix")&&!ftn_detail::same(r.message.to,"AreaMgr")))return read_failure<Result>(invalid("validate bounded provider response controls"));const auto material=app::ftn_message_fingerprint_material(r.message,*meta);if(!ftn_work_detail::same(message_detail::source_digest(material.identity),r.identity)||!ftn_work_detail::same(message_detail::source_digest(material.content),r.content))return read_failure<Result>(invalid("provider response fingerprint mismatch"));const auto fingerprint=ftn_import_detail::request_hash(r);const auto now=impl_->message_utc_now_?impl_->message_utc_now_():0;
    return impl_->write_result<Result>("record correlated provider response without acceptance inference",65536+r.message.text.size()*2,[a,r,meta=*meta,fingerprint,now](sqlite3* db,std::optional<Result>& out){message_detail::config_authority(db,a);
        {SqliteStatement prior(db,"SELECT p.operation_id,p.request_fingerprint FROM sfx_ftn_toss_progress p JOIN sfx_ftn_provider_responses x USING(import_id) WHERE p.ingress_id=?1 AND p.message_index=?2","reconcile exact provider response retry");prior.bind(1,r.ingress);prior.bind(2,r.message_index);if(prior.row()){if(ftn_work_detail::identifier(prior,0).bytes!=r.operation.bytes||!ftn_work_detail::same(ftn_work_detail::bytes<32>(prior,1),fingerprint))message_detail::conflict();out=Result{{},true};return SQLITE_OK;}}
        ftn_dispatch_detail::require_message(db,r.ingress,r.expected_configuration_revision);const auto c=ftn_detail::config(db);if(c.revision!=r.expected_configuration_revision||c.settings.mode==app::FtnMailerMode::disabled)message_detail::conflict();const auto& network=ftn_work_detail::network(c,r.network);if(!network.enabled||!app::ftn_local_address(network,meta.destination)||!app::ftn_local_address(network,r.header.destination))message_detail::unavailable();
        SqliteStatement expected(db,"SELECT p.provider,p.operation_id FROM sfx_ftn_provider_requests p JOIN sfx_ftn_control_intents c USING(operation_id) WHERE p.network=?1 COLLATE NOCASE AND c.msgid=?2 AND c.state=1 AND c.password_subject=1 LIMIT 2","require exact generated request REPLY in same network");expected.bind(1,network.code);expected.bind(2,ftn_import_detail::blob(meta.reply));if(!expected.row())message_detail::unavailable();const auto provider_code=expected.text(0);const auto request=ftn_work_detail::identifier(expected,1);if(expected.row())message_detail::conflict();const auto& provider=ftn_work_detail::link(c,network.code,provider_code,false);if(!ftn_import_detail::peer_address(provider,meta.origin)||!ftn_import_detail::peer_address(provider,r.header.origin))message_detail::unavailable();
        const auto sql=std::string("SELECT ")+ftn_work_detail::ingress_columns+" FROM sfx_ftn_ingress WHERE receipt_id=?1";SqliteStatement incoming(db,sql.c_str(),"require native complete same-provider custody");incoming.bind(1,r.ingress);if(!incoming.row())message_detail::unavailable();const auto receipt=ftn_work_detail::ingress(incoming);if((receipt.state!=app::FtnIngressState::received&&receipt.state!=app::FtnIngressState::processing)||!ftn_detail::same(receipt.network,network.code)||!ftn_detail::same(receipt.link,provider.code)||(!provider.credentials.packet.empty()&&!r.packet_password_verified)||(!app::ftn_verified_receipt(receipt)&&!r.packet_password_verified))message_detail::unavailable();
        const auto origin=app::format_ftn_address(meta.origin);{SqliteStatement duplicate(db,"SELECT r.import_id,r.content_sha256,x.request_operation FROM sfx_ftn_import_receipts r JOIN sfx_ftn_provider_responses x USING(import_id) WHERE r.network=?1 COLLATE NOCASE AND r.origin=?2 COLLATE NOCASE AND r.echo_tag='' AND r.identity_hash=?3","deduplicate exact original provider response identity");duplicate.bind(1,network.code);duplicate.bind(2,origin);duplicate.bind(3,r.identity);if(duplicate.row()){if(!ftn_work_detail::same(ftn_work_detail::bytes<32>(duplicate,1),r.content)||ftn_work_detail::identifier(duplicate,2).bytes!=request.bytes)message_detail::conflict();ftn_import_detail::progress(db,r,ftn_work_detail::identifier(duplicate,0),fingerprint);out=Result{{},true};return SQLITE_OK;}}
        SqliteStatement imported(db,"INSERT INTO sfx_ftn_import_receipts VALUES(?1,?2,?3,?4,'',?5,?6,?7,NULL,?8)","retain response identity and original packet custody without a fake caller");imported.bind(1,r.operation);imported.bind(2,r.ingress);imported.bind(3,r.message_index);imported.bind(4,network.code);imported.bind(5,origin);imported.bind(6,r.identity);imported.bind(7,r.content);imported.bind(8,now);imported.step();SqliteStatement response(db,"INSERT INTO sfx_ftn_provider_responses VALUES(?1,?2,'response_unrecognized')","retain exact correlation while leaving response semantics unqualified");response.bind(1,r.operation);response.bind(2,request);response.step();SqliteStatement state(db,"UPDATE sfx_ftn_provider_requests SET state=4,reason='response_unrecognized' WHERE operation_id=?1 AND state IN(0,1,4)","response received is not upstream acceptance");state.bind(1,request);state.step();ftn_import_detail::progress(db,r,r.operation,fingerprint);out=Result{{},false};return SQLITE_OK;});
}
