}
std::optional<app::CommittedMessage> committed(sqlite3* db,std::int64_t id){
    if(!id)return {};
    SqliteStatement q(db,"SELECT coalesce(area_number,0),arrival_ordinal,created_utc_seconds FROM sfx_local_messages WHERE message_id=?1","reconcile imported native identity without resurrecting deleted content");q.bind(1,id);if(!q.row())return {};return app::CommittedMessage{{id},q.int64(0),q.int64(1),q.int64(2)};
}
void progress(sqlite3* db,const app::FtnImportRequest& r,const app::Identifier128& imported,const app::FtnDigest& fingerprint){
    SqliteStatement q(db,"INSERT INTO sfx_ftn_toss_progress VALUES(?1,?2,?3,?4,?5)","commit exact per-receipt message progress");q.bind(1,r.ingress);q.bind(2,r.message_index);q.bind(3,r.operation);q.bind(4,imported);q.bind(5,fingerprint);q.step();
