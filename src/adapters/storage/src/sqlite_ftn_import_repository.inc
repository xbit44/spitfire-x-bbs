app::FtnDigest request_hash(const app::FtnImportRequest& r){
    std::string material="SFX/FTNImport/v1";const auto field=[&](std::string_view s){material+=';';material+=std::to_string(s.size());material+=':';material.append(s);};
    field(r.network);field(std::to_string(r.expected_configuration_revision));field(std::to_string(r.message_index));field(std::string_view(reinterpret_cast<const char*>(r.ingress.bytes.data()),16));
    const auto wire=app::encode_ftn_packet({r.header,{r.message}});if(!wire)message_detail::conflict();field(*wire);field(r.packet_password_verified?"verified":"not_verified");
    for(const auto& j:r.forwarding){field(std::string_view(reinterpret_cast<const char*>(j.id.bytes.data()),16));field(std::string_view(reinterpret_cast<const char*>(j.operation.bytes.data()),16));field(j.network);field(j.link);field(j.echo_tag);field(std::to_string(j.ordinal));field(std::to_string(static_cast<unsigned>(j.kind)));field(std::to_string(static_cast<unsigned>(j.flavor)));field(app::format_binkp_file(j.file,false));field(std::string_view(reinterpret_cast<const char*>(j.digest.data()),32));}
