std::optional<app::AccountId> recipient(sqlite3* db,std::string_view name,bool required){
    const auto key=message_detail::recipient_key(app::qwk_cp437_to_utf8(name));if(!required&&(key=="all"||key=="all callers"))return {};
    SqliteStatement q(db,"SELECT DISTINCT a.account_id FROM sfx_accounts a JOIN sfx_security_levels l ON l.security_level=a.security_level LEFT JOIN sfx_account_profiles p USING(account_id) WHERE a.account_state='active' AND l.level_state='active' AND (a.name_key=?1 OR lower(p.real_name)=?1 OR (?1 IN('sysop','system operator') AND a.account_id=(SELECT account_id FROM sfx_system_sysop WHERE singleton_id=1) AND a.security_level>=(SELECT sysop_threshold FROM sfx_security_policy))) LIMIT 2","resolve exact FTN alias/real name/System Sysop without a catchall");q.bind(1,key);
    if(!q.row()){if(required)throw StorageFailure(StorageErrorCode::not_found,"FTN local recipient unmatched",SQLITE_NOTFOUND);return {};}
