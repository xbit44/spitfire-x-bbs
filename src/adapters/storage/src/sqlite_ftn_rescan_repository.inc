namespace ftn_rescan_detail {
namespace app=application;
app::FtnRescanItem read(sqlite3* db,const app::FtnConfiguration& config,const app::Identifier128& request){
    SqliteStatement q(db,"SELECT network,link,echo_tag,remaining,before_arrival,state FROM sfx_ftn_rescan_requests WHERE operation_id=?1","read bounded original rescan request");q.bind(1,request);if(!q.row()||q.int64(5)!=0)message_detail::unavailable();app::FtnRescanItem out;out.request=request;out.before=q.int64(4);auto& t=out.text;t.network=q.text(0);t.via_link=q.text(1);t.tag=q.text(2);t.operation=ftn_control_detail::derived(request,"empty");
    try{const auto& network=ftn_work_detail::network(config,t.network);const auto echo=std::find_if(config.message_echoes.begin(),config.message_echoes.end(),[&](const auto& e){return ftn_detail::same(e.network,t.network)&&ftn_detail::same(e.tag,t.tag);});
    if(!network.enabled||echo==config.message_echoes.end()||!echo->store_locally||!echo->local_echo||!app::ftn_echo_permission(config,t.network,t.via_link,t.tag,false,false)||!app::ftn_echo_permission(config,t.network,t.via_link,t.tag,false,false,true)){t.reason="ftn_rescan_permission_changed";return out;}
    {SqliteStatement pause(db,"SELECT paused FROM sfx_ftn_link_state WHERE network=?1 AND link=?2","respect Echo-only pause during rescan");pause.bind(1,t.network);pause.bind(2,t.via_link);if(pause.row()&&pause.boolean(0)){t.reason="ftn_rescan_paused";return out;}}
    if(q.int64(3)==0||out.before==0)return out;
    SqliteStatement message(db,message_detail::active_message_sql(db,"SELECT message_id,arrival_ordinal,author_account_id,created_utc_seconds FROM sfx_active_local_messages WHERE kind=0 AND echo_id=?1 AND arrival_ordinal<=?2 ORDER BY arrival_ordinal DESC LIMIT 1").c_str(),"select at most one retained message inside request-time snapshot boundary");message.bind(1,echo->local_echo);message.bind(2,out.before);if(!message.row())return out;t.message={message.int64(0)};out.arrival=message.int64(1);t.created=message.int64(3);
    if(!message.is_null(2)){const auto destination=t.via_link;const auto tag=t.tag;t=ftn_scan_detail::read(db,config,t.message.value,t.network);t.via_link=destination;t.tag=tag;}
    else {SqliteStatement original(db,"SELECT m.wire_from,m.wire_to,m.wire_subject,m.wire_text,m.original_date,m.msgid,m.reply,r.origin,m.wire_attributes FROM sfx_ftn_message_metadata m JOIN sfx_ftn_import_receipts r USING(import_id) WHERE m.message_id=?1 AND r.network=?2 COLLATE NOCASE AND r.echo_tag=?3 COLLATE NOCASE","read exact retained imported wire content without new identity");original.bind(1,t.message.value);original.bind(2,t.network);original.bind(3,t.tag);if(!original.row())message_detail::unavailable();const auto origin=app::parse_ftn_address(original.text(7));if(!origin)message_detail::unavailable();out.original_origin=*origin;app::FtnPackedMessage wire;wire.from=message_detail::bytes(original,0);wire.to=message_detail::bytes(original,1);wire.subject=message_detail::bytes(original,2);wire.text=message_detail::bytes(original,3);wire.date=message_detail::bytes(original,4);wire.attributes=static_cast<std::uint16_t>(original.int64(8));wire.origin_net=origin->net;wire.origin_node=origin->node;const auto local=app::parse_ftn_address(network.address);if(!local)message_detail::unavailable();wire.destination_net=local->net;wire.destination_node=local->node;t.msgid=message_detail::bytes(original,5);t.reply=message_detail::bytes(original,6);t.from=wire.from;t.to=wire.to;t.subject=wire.subject;t.body=wire.text;t.source_aka=network.address;out.original=std::move(wire);}
    t.operation=ftn_control_detail::derived(request,"message/"+std::to_string(t.message.value));std::string material="SFX/Rescan/v1";for(const auto* field:{&t.network,&t.via_link,&t.tag,&t.source_aka,&t.from,&t.to,&t.subject,&t.body,&t.msgid,&t.reply,&t.origin_line}){material+=';';material+=std::to_string(field->size());material+=':';material+=*field;}material+=';'+std::to_string(out.before)+';'+std::to_string(out.arrival)+';'+std::to_string(t.created);if(out.original)material+=';'+out.original->date+';'+app::format_ftn_address(out.original_origin)+';'+std::to_string(out.original->attributes);t.fingerprint=message_detail::source_digest(material);return out;
    }catch(const StorageFailure& error){if(error.code()!=app::StorageErrorCode::not_found&&error.code()!=app::StorageErrorCode::invalid_argument)throw;t.reason="ftn_rescan_source_unavailable";t.operation=ftn_control_detail::derived(request,"unavailable");t.fingerprint={};out.original.reset();return out;}
}
}
application::StorageResult<std::optional<application::FtnRescanItem>> SqliteAccountRepository::next_ftn_rescan(const application::MessageConfigurationActor& a,const application::Identifier128& after){
    using Result=std::optional<application::FtnRescanItem>;if(!ftn_work_detail::owner(a))return read_failure<Result>(invalid("validate rescan owner"));return impl_->readers_.read<Result>("read bounded next own-link rescan work",[a,after](sqlite3* db)->Result{message_detail::ReadSnapshot snapshot(db);message_detail::config_authority(db,a);const auto c=ftn_detail::config(db);SqliteStatement q(db,"SELECT operation_id FROM sfx_ftn_rescan_requests WHERE state=0 AND operation_id>?1 ORDER BY operation_id LIMIT 1","rotate rescan requests without starving later links");q.bind(1,after);if(!q.row())return {};return ftn_rescan_detail::read(db,c,ftn_work_detail::identifier(q,0));});
}
application::StorageStatus SqliteAccountRepository::commit_ftn_rescan(const application::MessageConfigurationActor& a,std::int64_t revision,const application::FtnRescanItem& item,const std::optional<application::FtnOutboundJob>& job){
    namespace app=application;if(!ftn_work_detail::owner(a)||revision<1||!item.request.valid()||!item.text.operation.valid()||item.before<0||item.arrival<0||(job&&(!ftn_work_detail::valid_job(*job)||job->kind!=app::FtnOutboundKind::packet)))return invalid("validate exact bounded rescan artifact");const auto now=impl_->message_utc_now_?impl_->message_utc_now_():0;
    return impl_->write_result<bool>("advance rescan only with exact durable artifact",65536+item.text.body.size()*2+(item.original?item.original->text.size():0),[a,revision,item,job,now](sqlite3* db,std::optional<bool>& out){message_detail::config_authority(db,a);const auto c=ftn_detail::config(db);if(c.revision!=revision||c.settings.mode==app::FtnMailerMode::disabled)message_detail::conflict();
        {SqliteStatement saved(db,"SELECT operation_id,fingerprint,job_id FROM sfx_ftn_rescan_jobs WHERE request_id=?1 AND arrival=?2","reconcile uncertain rescan commit without counting or sending twice");saved.bind(1,item.request);saved.bind(2,item.arrival);if(saved.row()){if(!job||ftn_work_detail::identifier(saved,0).bytes!=item.text.operation.bytes||!ftn_work_detail::same(ftn_work_detail::bytes<32>(saved,1),item.text.fingerprint)||ftn_work_detail::identifier(saved,2).bytes!=job->id.bytes)message_detail::conflict();auto tagged=*job;tagged.echo_tag=item.text.tag;ftn_work_detail::queue(db,c,{tagged},now);out=true;return SQLITE_OK;}}
        if(!job){SqliteStatement finished(db,"SELECT state,before_arrival,reason,network,link,echo_tag FROM sfx_ftn_rescan_requests WHERE operation_id=?1","reconcile terminal rescan result without manufacturing work");finished.bind(1,item.request);if(finished.row()&&finished.int64(0)!=0){if(finished.int64(1)!=item.before||finished.text(2)!=item.text.reason||finished.text(3)!=item.text.network||finished.text(4)!=item.text.via_link||finished.text(5)!=item.text.tag)message_detail::conflict();out=true;return SQLITE_OK;}}
        const auto current=ftn_rescan_detail::read(db,c,item.request);if(current.before!=item.before||current.arrival!=item.arrival||current.text.operation.bytes!=item.text.operation.bytes||current.text.reason!=item.text.reason||!ftn_work_detail::same(current.text.fingerprint,item.text.fingerprint)||current.text.reason=="ftn_rescan_paused")message_detail::conflict();
        if(!current.text.reason.empty()||!current.arrival){if(job)message_detail::conflict();SqliteStatement finish(db,"UPDATE sfx_ftn_rescan_requests SET state=?2,reason=?3 WHERE operation_id=?1 AND state=0","finish exhausted or no-longer-permitted rescan without an artifact");finish.bind(1,item.request);finish.bind(2,static_cast<std::int64_t>(current.text.reason.empty()?1:2));finish.bind(3,current.text.reason);finish.step();out=true;return SQLITE_OK;}
        if(!job||job->operation.bytes!=current.text.operation.bytes||job->network!=current.text.network||job->link!=current.text.via_link||(!job->echo_tag.empty()&&job->echo_tag!=current.text.tag))message_detail::conflict();
        auto tagged=*job;tagged.echo_tag=current.text.tag;ftn_work_detail::queue(db,c,{tagged},now);if(!current.original)ftn_scan_detail::freeze(db,current.text);SqliteStatement bind(db,"INSERT INTO sfx_ftn_rescan_jobs VALUES(?1,?2,?3,?4,?5)","bind exact original identity rescan to one job");bind.bind(1,item.request);bind.bind(2,item.arrival);bind.bind(3,item.text.operation);bind.bind(4,item.text.fingerprint);bind.bind(5,job->id);bind.step();SqliteStatement advance(db,"UPDATE sfx_ftn_rescan_requests SET before_arrival=?2,remaining=remaining-1,state=CASE WHEN remaining=1 THEN 1 ELSE 0 END WHERE operation_id=?1 AND remaining>0 AND state=0","consume one bounded rescan item atomically");advance.bind(1,item.request);advance.bind(2,item.arrival-1);advance.step();if(sqlite3_changes(db)!=1)message_detail::conflict();out=true;return SQLITE_OK;}).status;
}
