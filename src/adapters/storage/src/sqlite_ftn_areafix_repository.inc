            SqliteStatement status(db,"SELECT echo_tag,state,remaining,reason FROM sfx_ftn_rescan_requests WHERE network=?1 AND link=?2 ORDER BY rowid DESC LIMIT 17","report only own bounded rescan request results");status.bind(1,net.code);status.bind(2,requester.code);unsigned count{};while(status.row()){if(++count>16){plan.response+="Additional rescan history omitted.\r";break;}plan.response+="Rescan "+status.text(0)+": ";if(status.int64(1)==0)plan.response+=std::to_string(status.int64(2))+" remaining.\r";else if(status.int64(1)==1)plan.response+="finished.\r";else plan.response+=status.text(3)=="ftn_rescan_permission_changed"?"stopped after permission change.\r":"stopped because original message source is unavailable.\r";}
