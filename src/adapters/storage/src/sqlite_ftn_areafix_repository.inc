application::StorageResult<std::vector<application::FtnControlIntent>> SqliteAccountRepository::pending_ftn_control(const application::MessageConfigurationActor& a,const application::Identifier128& after,std::size_t maximum){
    using Result=std::vector<application::FtnControlIntent>;if(!ftn_work_detail::owner(a)||!maximum||maximum>16)return read_failure<Result>(invalid("validate owner control page"));return impl_->readers_.read<Result>("read pending generated FTN controls",[a,after,maximum](sqlite3* db){message_detail::ReadSnapshot snapshot(db);message_detail::config_authority(db,a);SqliteStatement q(db,"SELECT operation_id FROM sfx_ftn_control_intents WHERE state=0 AND operation_id>?2 ORDER BY operation_id LIMIT ?1","bound generated-message scan");q.bind(1,static_cast<std::int64_t>(maximum));q.bind(2,after);Result out;while(q.row())out.push_back(ftn_control_detail::read(db,ftn_work_detail::identifier(q,0)));return out;});
