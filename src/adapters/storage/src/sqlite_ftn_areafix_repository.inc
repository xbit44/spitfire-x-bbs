application::StorageStatus SqliteAccountRepository::commit_ftn_control(const application::MessageConfigurationActor& a,std::int64_t revision,const application::FtnControlIntent& intent,const application::FtnOutboundJob& job){
    if(!ftn_work_detail::owner(a)||revision<1||!intent.text.operation.valid()||!ftn_work_detail::valid_job(job)||job.operation.bytes!=intent.text.operation.bytes||job.kind!=application::FtnOutboundKind::packet||!job.echo_tag.empty())return invalid("validate generated FTN artifact publication");
