namespace ftn_setup_queue_detail {
void create(sqlite3* db,const application::FtnTransferToken& token,const application::FtnConfiguration& c,std::int64_t now){
    namespace app=application;
    if(!c.setup_subscriptions)return;
    const auto& request=*c.setup_subscriptions;const auto& n=ftn_work_detail::network(c,request.network);const auto& link=ftn_work_detail::link(c,n.code,request.link,true);
    if(!n.enabled||!link.enabled||!app::ftn_inbound(link)||link.credentials.areafix.empty())message_detail::unavailable();
    std::vector<std::string> tags;
    for(const auto& tag:request.tags){
        if(!app::ftn_echo_permission(c,n.code,link.code,tag,false,true))message_detail::unavailable();
        SqliteStatement prior(db,"SELECT 1 FROM sfx_ftn_provider_requests WHERE network=?1 AND provider=?2 AND echo_tag=?3","retain existing durable provider requests");prior.bind(1,n.code);prior.bind(2,link.code);prior.bind(3,tag);if(prior.row())continue;
        tags.push_back(tag);
    }
    if(tags.empty())return;
    const auto destination=app::parse_ftn_address(link.address);const auto route=destination?app::ftn_route_link(c,n.code,*destination):std::nullopt;if(!route||*route!=link.code)message_detail::unavailable();
    app::Identifier128 parent;parent.bytes=token;
    for(std::size_t offset=0;offset<tags.size();offset+=64){
        const auto end=std::min(tags.size(),offset+64);std::string body;for(auto i=offset;i<end;++i)body+="+"+tags[i]+"\r";
        const auto operation=ftn_control_detail::derived(parent,"setup-subscriptions/"+std::to_string(offset/64));
    ftn_control_detail::create(db,operation,n.code,n.address,link.code,link.address,"AreaFix",{},body,true,now);
    for(auto i=offset;i<end;++i){const auto& tag=tags[i];SqliteStatement add(db,"INSERT INTO sfx_ftn_provider_requests VALUES(?1,?2,?3,?4,0,'')","queue reviewed subscription without claiming hub acceptance");add.bind(1,n.code);add.bind(2,link.code);add.bind(3,tag);add.bind(4,operation);add.step();}
    }
}
}
