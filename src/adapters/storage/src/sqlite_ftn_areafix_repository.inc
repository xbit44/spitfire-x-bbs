        if(saved.password_subject){if(target.credentials.areafix.empty()||!application::ftn_inbound(target))message_detail::unavailable();SqliteStatement tags(db,"SELECT echo_tag,state FROM sfx_ftn_provider_requests WHERE operation_id=?1 AND network=?2 AND provider=?3","recheck current explicit provider receive permission");tags.bind(1,saved.text.operation);tags.bind(2,saved.text.network);tags.bind(3,target.code);bool any{};while(tags.row()){any=true;if(tags.int64(1)==3||!application::ftn_echo_permission(c,saved.text.network,target.code,tags.text(0),false,true))message_detail::unavailable();}if(!any)message_detail::unavailable();}
        SqliteStatement state(db,"SELECT state,job_id FROM sfx_ftn_control_intents WHERE operation_id=?1","reconcile generated artifact identity");state.bind(1,saved.text.operation);if(!state.row())message_detail::unavailable();if(state.int64(0)==1&&ftn_work_detail::identifier(state,1).bytes!=job.id.bytes)message_detail::conflict();ftn_work_detail::queue(db,c,{job},now);SqliteStatement finish(db,"UPDATE sfx_ftn_control_intents SET state=1,job_id=?2 WHERE operation_id=?1 AND state=0","publish generated message only with immutable queued artifact");finish.bind(1,saved.text.operation);finish.bind(2,job.id);finish.step();out=true;return SQLITE_OK;}).status;
}
