        ftn_dispatch_detail::require_message(db,r.ingress,r.expected_configuration_revision);auto c=ftn_detail::config(db);if(c.revision!=r.expected_configuration_revision||c.settings.mode==app::FtnMailerMode::disabled)message_detail::conflict();const auto& net=ftn_work_detail::network(c,r.network);const auto& requester=ftn_work_detail::link(c,net.code,r.requesting_link,true);
        if(!net.enabled||!app::ftn_local_address(net,r.destination)||!app::ftn_local_address(net,r.envelope_destination)||!ftn_import_detail::peer_address(requester,r.origin)||!app::ftn_areafix_enabled(requester)||requester.credentials.areafix.empty())message_detail::unavailable();
        const auto sql=std::string("SELECT ")+ftn_work_detail::ingress_columns+" FROM sfx_ftn_ingress WHERE receipt_id=?1";SqliteStatement received(db,sql.c_str(),"require complete actual packet custody for AreaFix");received.bind(1,r.ingress);if(!received.row())message_detail::unavailable();const auto receipt=ftn_work_detail::ingress(received);if(receipt.state!=app::FtnIngressState::received&&receipt.state!=app::FtnIngressState::processing)message_detail::unavailable();
        if(receipt.proof!=app::FtnIngressProof::nonsecure){if(!ftn_detail::same(receipt.network,net.code))message_detail::unavailable();const auto& carrier=ftn_work_detail::link(c,net.code,receipt.link,receipt.outbound);if(!ftn_import_detail::peer_address(carrier,r.envelope_origin)||(!carrier.credentials.packet.empty()&&!r.packet_password_verified))message_detail::unavailable();}
