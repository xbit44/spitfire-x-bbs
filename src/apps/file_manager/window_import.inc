bool State::import_options(){
    const auto values=show_form(window,appearance,L"Import batch options",L"Default descriptions: usable FILE_ID.DIZ, otherwise filename. Blank attribution uses the importing Sysop's public caller name. Imports are not automatically malware-scanned; no caller upload credit is created.",{field_text(L"Optional short description override",options.descriptions?wide(options.descriptions->short_text):L""),field_text(L"Optional extended description override",options.descriptions?wide(options.descriptions->long_text):L"",true),field_text(L"Optional PUBLIC uploader override",wide(options.uploader)),field_choice(L"Outside-folder action",{{1,L"Copy (leave source unchanged)"},{2,L"Move (explicitly remove exact original after commit)"}},static_cast<std::int64_t>(options.mode)),field_check(L"Allow duplicate CONTENT (never filename replacement)",options.duplicates),field_check(L"Sysop-only file",options.sysop_only)},[](const auto& fields)->std::optional<std::wstring>{const app::FileDescriptions descriptions{utf8(fields[0].value),utf8(fields[1].value)};if((!descriptions.short_text.empty()||!descriptions.long_text.empty())&&!app::valid_file_descriptions(descriptions))return L"Provide a valid short description when overriding descriptions.";const auto uploader_name=utf8(fields[2].value);if(uploader_name.size()>64||app::sanitize_file_text(uploader_name,64,false)!=uploader_name)return L"Use safe public attribution of at most 64 UTF-8 bytes.";return {};});
    if(!values)return false;options.descriptions.reset();if(!(*values)[0].value.empty()||!(*values)[1].value.empty())options.descriptions=app::FileDescriptions{utf8((*values)[0].value),utf8((*values)[1].value)};options.uploader=utf8((*values)[2].value);options.mode=static_cast<app::FileImportMode>((*values)[3].selected);options.duplicates=(*values)[4].checked;options.sysop_only=(*values)[5].checked;return true;
}
void State::begin_import(std::vector<std::filesystem::path> sources){
    if(!area.value||sources.empty()||sources.size()>1000){message(L"Select one area and between 1 and 1,000 files. Nothing imported.");return;}batch.clear();batch_area=area;options={};for(auto& path:sources){ImportRow row;row.source=std::move(path);row.operation=fresh_id();row.outcome=L"Not yet previewed";batch.push_back(std::move(row));}selected.reset();mode=Mode::import_preview;list();fields();batch_phase=BatchPhase::preview;batch_index=0;next_import();
}
void State::next_import(){
    if(batch_phase==BatchPhase::none||closing)return;
    while(batch_index<batch.size()&&(!batch[batch_index].selected||batch[batch_index].added||batch[batch_index].held))++batch_index;
    if(batch_index>=batch.size()){const auto finished=batch_phase;batch_phase=BatchPhase::none;mode=Mode::import_preview;list();fields();const auto added=std::count_if(batch.begin(),batch.end(),[](const auto& row){return row.added;});const auto held=std::count_if(batch.begin(),batch.end(),[](const auto& row){return row.held;});message(finished==BatchPhase::preview?L"Preview complete. Check selected rows and duplicate warnings, then confirm the batch. No files added yet.":L"Batch finished: "+std::to_wstring(added)+L" added; "+std::to_wstring(held)+L" held. Other rows were skipped/refused, not reported as success.");enable();return;}
    auto& row=batch[batch_index];app::FileManagementTask task;task.job=fresh_id();
    if(batch_phase==BatchPhase::preview){task.kind=app::FileManagementTaskKind::preview_import;auto& choice=task.choice;choice.operation=row.operation;choice.area=batch_area;choice.source_path=row.source.u8string();choice.mode=options.mode;choice.descriptions=options.descriptions;choice.public_uploader=options.uploader;choice.allow_duplicate_content=options.duplicates;choice.sysop_only=options.sysop_only;start(task,Purpose::preview_import);}
    else if(row.preview){task.kind=app::FileManagementTaskKind::import_file;task.import=*row.preview;start(task,Purpose::accept_import);}
    else{row.outcome=L"Skipped: no verified preview";++batch_index;next_import();}
}
void State::confirm_batch(){
    if(!available()||mode!=Mode::import_preview)return;std::size_t count{},duplicates{};for(const auto& row:batch)if(row.selected&&row.preview&&!row.added&&!row.held){++count;if(row.duplicates)++duplicates;}
    if(!count)return;if(duplicates&&!options.duplicates){message(L"Duplicate content was found. Deselect those items or explicitly enable the duplicate-content override in Batch options and preview again. Filename replacement is never permitted.");return;}
    const auto question=L"Import "+std::to_wstring(count)+L" selected, verified previews?\n"+std::to_wstring(duplicates)+L" contain existing catalog content.\nSources and destinations will be rechecked. No filename is overwritten. Copies leave the source; explicit Moves remove only the exact original after commit.";
    if(MessageBoxW(window,question.c_str(),L"Confirm import batch",MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2)!=IDYES)return;batch_phase=BatchPhase::accept;batch_index=0;next_import();
}
void State::discover(bool folder){
    if(!available()||!area.value)return;app::FileManagementTask task;task.job=fresh_id();task.discovery_area=area;task.kind=folder?app::FileManagementTaskKind::discover_import_folder:app::FileManagementTaskKind::discover_unregistered;
    if(folder){const auto chosen=pick_import_sources(window,root,true);if(chosen.cancelled)return;if(!chosen.error.empty()||chosen.paths.size()!=1){message(chosen.error.empty()?L"Select one import folder.":chosen.error);return;}task.discovery_folder=chosen.paths.front().u8string();}
    options={};discovery={};start(task,Purpose::discovery);
}
