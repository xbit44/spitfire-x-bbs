void State::begin_hatch(){
    const auto picks=selected();if(!available()||picks.size()!=1||picks[0]>=rows.size())return;const auto& row=rows[picks[0]];if(row.operation_pending||row.purged||row.file.state!=app::FileCatalogState::available)return;hatch_selection=row;read_hatches();
}
void State::read_hatches(app::Identifier128 after){
    if(!hatch_selection)return;ClientCommand request;request.kind=ClientCommandKind::read;request.query.kind=app::FileManagementQueryKind::hatches;request.query.selection=hatch_selection->file.id;request.query.pending_after=after;if(!send(request)){hatch_selection.reset();message(L"Unfinished hatches could not be read. No hatch was started.");}
}
void State::new_hatch(){
    if(!hatch_selection)return;const auto& row=*hatch_selection;app::FileManagementTask task;task.job=fresh_id();task.kind=app::FileManagementTaskKind::inspect_files;task.inspection_request.filter.area=row.file.area;task.inspection_request.filter.search=row.file.name;task.inspection_request.after.value=row.file.id.value-1;if(!start(task,Purpose::hatch_verify))hatch_selection.reset();
}
void State::review_pending_hatch(const ClientReply& reply){
    if(!hatch_selection)return;
    if(reply.read_code!=app::LocalAccountResultCode::ok){hatch_selection.reset();message(L"Unfinished hatches could not be read. No hatch was started.");return;}
    if(reply.pending.empty()){if(!last.query.pending_after.valid())new_hatch();else{hatch_selection.reset();message(L"No further unfinished hatch remains. Reopen Hatch File to review current state.");}return;}
    if(reply.pending.size()!=1||!reply.pending[0].hatch||!(reply.pending[0].file==hatch_selection->file.id)){hatch_selection.reset();message(L"Hatch review did not match the selected file. No hatch was started.");return;}
    const auto& row=reply.pending[0];const auto& original=*row.hatch;std::wstring operation;constexpr wchar_t hex[]=L"0123456789abcdef";for(const auto byte:original.operation.bytes){operation+=hex[byte>>4];operation+=hex[byte&15];}
    std::wstring review=L"Original file: "+wide(row.filename)+L"\nFile record: "+std::to_wstring(row.file.value)+L"\nOperation: "+operation+L"\nNetwork: "+wide(original.network)+L"\nFile echo: "+wide(original.tag)+L"\nOriginating address: "+wide(original.origin)+L"\nStatus: "+(row.state==static_cast<unsigned>(app::FtnHatchState::held)?std::wstring(L"Held"):row.state==static_cast<unsigned>(app::FtnHatchState::queued)?std::wstring(L"Queued"):std::wstring(L"Preparing"))+L"\nReason: "+wide(row.detail)+L"\nOriginal destinations:\n";for(const auto& link:original.destinations)review+=L"  "+wide(link)+L"\n";review+=L"\nOriginal description:\n"+wide(original.description);
    show_readonly(window,appearance,L"Unfinished Hatch Review",review);
    FormField action;action.label=L"Action for this original hatch";action.kind=FormFieldKind::choice;action.choices={{0,L"Cancel"},{1,L"Retry this original hatch"},{2,L"Prepare a new hatch"}};if(reply.pending_next.valid())action.choices.push_back({3,L"Review next unfinished hatch"});action.selected=0;
    const auto chosen=show_form(window,appearance,L"Unfinished Hatch",L"Retry keeps the original choices. Changed or unavailable inputs remain held. A new hatch requires its own review and confirmation.",{action});if(!chosen||(*chosen)[0].selected==0){hatch_selection.reset();return;}
    if((*chosen)[0].selected==3){read_hatches(reply.pending_next);return;}
    if((*chosen)[0].selected==2){new_hatch();return;}
    if(!show_readonly(window,appearance,L"Retry Original Hatch?",review+L"\n\nRetry this exact original hatch?\nAlready queued work will report its recorded result.\nNo replacement request will be created.",true)){hatch_selection.reset();return;}
    app::FileManagementTask task;task.job=fresh_id();task.kind=app::FileManagementTaskKind::reconcile_hatch;task.target=original.operation;if(!start(task,Purpose::hatch))hatch_selection.reset();
}
