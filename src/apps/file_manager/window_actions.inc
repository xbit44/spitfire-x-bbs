    std::optional<app::FileOperationAction> action;switch(id){case rename_file:action=app::FileOperationAction::rename;break;case copy_file:action=app::FileOperationAction::copy;break;case move_file:action=app::FileOperationAction::move;break;case remove_file:action=app::FileOperationAction::remove;break;case restore_file:action=app::FileOperationAction::restore;break;case purge_file:action=app::FileOperationAction::purge;break;case mark_missing:action=app::FileOperationAction::mark_missing;break;default:break;}if(action)dirty_gate([this,action]{operation(*action);});
}
void State::operation(app::FileOperationAction action){
