    if(closing)return;if(tracking.blocks_edits()){if(MessageBoxW(window,L"A job is running or its status is unknown. Closing does not assert success or undo a completed operation.\nThe running BBS may finish it; offline work will be safely cancelled/joined. Review pending work next time. Close File Manager?",L"Unfinished owner job",MB_YESNO|MB_ICONWARNING|MB_DEFBUTTON2)!=IDYES)return;}
