    if(id==40001){MessageBoxW(window,L"Select an area to import or find unregistered files. All Areas supports catalog search.\n\nMetadata changes use current-record revisions. Import previews do not add files; confirm the selected batch once. Missing descriptions use FILE_ID.DIZ when usable, otherwise the filename. Duplicate content requires an explicit override; names are never overwritten.\n\nRemove is recoverable; Purge is permanent and separately confirmed. Held incoming files require explicit review. Accepted incoming staging can only be reconciled against verified native storage.\n\nUnknown jobs freeze new edits. Check status or retry SAME request before attempting another operation. Preview sources expire after five minutes without navigation. Configuration of areas/paths/policies belongs in SFXConfig.",L"Spitfire-X File Manager",MB_OK|MB_ICONINFORMATION);return;}
    if(id==status_check||id==retry_same||id==cancel_job){if(!worker||worker->busy()||!tracking.blocks_edits()||!tracking.exact_task())return;ClientCommand request;request.job=tracking.exact_task()->job;request.kind=id==status_check?ClientCommandKind::status:id==cancel_job?ClientCommandKind::cancel:ClientCommandKind::start;if(id==retry_same)request.task=*tracking.exact_task();if(id==cancel_job)cancel_sent=true;send(request);return;}
    if(!available())return;
    if(id==save){save_metadata();return;}
    if(id==show_pending){dirty_gate([this]{pending_after={};pending_page();});return;}
    if(id==reconcile||id==cancel_intent||id==purge_intake){pending_action(id);return;}
    if(id==select_all){for(auto& row:batch)if(!row.added&&!row.held)row.selected=true;list();enable();return;}
    if(id==batch_options){if(import_options()){for(auto& row:batch)if(!row.added&&!row.held){row.preview.reset();row.operation=fresh_id();row.outcome=L"Options changed; preview again";}mode=Mode::unregistered;list();enable();}return;}
    if(id==preview_import){if(batch.empty())return;batch_index=0;batch_phase=BatchPhase::preview;mode=Mode::import_preview;next_import();return;}
    if(id==confirm_import){confirm_batch();return;}
