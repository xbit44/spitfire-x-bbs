        std::vector<std::pair<std::int64_t,std::wstring>> choices;for(const auto& row:configuration->areas)if(action!=app::FileOperationAction::rename||row.area.id==selected->file.area)choices.push_back({row.area.id.value,wide(row.area.name)+(row.area.enabled?L"":L" (disabled)")});
        const auto changed=show_form(window,appearance,L"Preview file destination",L"Existing names are never replaced. Moving/copying changes payload/catalog only after native verification. Missing-file Restore requires the same original area and filename.",{field_choice(L"Destination area",std::move(choices),selected->file.area.value),field_text(L"Destination filename",wide(selected->file.name)),field_check(L"Allow duplicate CONTENT (never overwrite a filename)",false)},[](const auto& fields)->std::optional<std::wstring>{if(!app::valid_file_name(utf8(fields[1].value)))return L"Use one valid filename, not a path.";return {};});if(!changed)return;
        request.destination={(*changed)[0].selected};request.filename=utf8((*changed)[1].value);request.allow_duplicate_content=(*changed)[2].checked;const auto found=std::find_if(configuration->areas.begin(),configuration->areas.end(),[&](const auto& row){return row.area.id==request.destination;});if(found==configuration->areas.end())return;request.expected_destination_revision=found->area.revision;
    }else{
        const auto question=action==app::FileOperationAction::purge?L"Permanently purge this recoverably removed file?\nThis cannot be undone. Pending accepted-upload staging must be reconciled first.":action==app::FileOperationAction::remove?L"Remove this file from the visible library and retain its exact payload privately until an explicit restore or purge?":L"Mark this catalog entry missing ONLY if native verification confirms its payload is absent? No payload will be deleted.";
        if(MessageBoxW(window,question,L"Confirm exact file operation",MB_YESNO|MB_ICONWARNING|MB_DEFBUTTON2)!=IDYES)return;
    }
