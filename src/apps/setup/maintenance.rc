#include <windows.h>
#include "../product_version.h"
301 DIALOGEX 0,0,372,206
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Spitfire-X Portable ClamAV Maintenance"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Install the supported Portable ClamAV component for this SFX installation:",-1,12,12,348,20
 LTEXT "",101,12,36,348,28
 LTEXT "Stop the BBS and Control Panel first. Config may remain open. This downloads the verified official package and requests Windows administrator approval only for protected installation. No scanning-policy choice is changed.",-1,12,68,348,42
 LTEXT "Ready. Choose Install / Verify to continue.",102,12,117,348,52
 DEFPUSHBUTTON "Install / Verify",IDOK,184,178,100,18
 PUSHBUTTON "Close",IDCANCEL,292,178,68,18
END
VS_VERSION_INFO VERSIONINFO
 FILEVERSION SFX_PRODUCT_VERSION_NUMERIC
 PRODUCTVERSION SFX_PRODUCT_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Spitfire-X\0"
   VALUE "FileDescription", "Spitfire-X Portable ClamAV Maintenance\0"
   VALUE "FileVersion", SFX_PRODUCT_VERSION_STRING
   VALUE "InternalName", "SFXMaintenance\0"
   VALUE "OriginalFilename", "SFXMaintenance.exe\0"
   VALUE "ProductName", "Spitfire-X BBS\0"
   VALUE "ProductVersion", SFX_PRODUCT_VERSION_PRODUCT_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
