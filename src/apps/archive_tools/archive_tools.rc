#include <windows.h>
#include "../product_version.h"
1 VERSIONINFO
 FILEVERSION SFX_PRODUCT_VERSION_NUMERIC
 PRODUCTVERSION SFX_PRODUCT_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Spitfire-X\0"
   VALUE "FileDescription", "Spitfire-X BBS Archive Helper\0"
   VALUE "FileVersion", SFX_PRODUCT_VERSION_STRING
   VALUE "ProductName", "Spitfire-X BBS\0"
   VALUE "ProductVersion", SFX_PRODUCT_VERSION_PRODUCT_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
