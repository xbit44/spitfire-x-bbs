bool ns_command(State& s,int id,int notification){
    if(id==IDC_FTN_ECHO_CLONE){ns_clone(s,true);return true;}if(id<IDC_NS_TITLE||id>IDC_NS_CALLER_NAME)return false;auto& u=s.ftn.setup;if(!u.active&&!u.clone)return true;if(s.ftn.populating)return true;if(s.ftn.pending){ns_error(s,L"Check Save Result before another setup action.");return true;}
    if(notification==EN_CHANGE||notification==CBN_SELCHANGE||(notification==BN_CLICKED&&id>=IDC_NS_CLONE_COUNT&&id<=IDC_NS_CLONE_POST)){u.clone_preview.reset();EnableWindow(ns_control(s,IDC_NS_CLONE_APPLY),FALSE);if(notification==EN_CHANGE)s.ftn.draft_changed=true;if(u.active&&(notification==EN_CHANGE||notification==CBN_SELCHANGE))u.edited=true;}
    if(notification==BN_CLICKED&&id>=IDC_NS_CLONE_COUNT&&id<=IDC_NS_CLONE_POST)EnableWindow(ns_control(s,IDC_NS_VALUE_COUNT+id-IDC_NS_CLONE_COUNT),door_checked(ns_control(s,id)));
    switch(id){
    case IDC_NS_PRESET:if(notification==CBN_SELCHANGE){const auto p=SendMessageW(ns_control(s,id),CB_GETCURSEL,0,0);door_set(ns_control(s,IDC_NS_NAME),p==0?"FidoNet":p==1?"fsxNet":"");door_set(ns_control(s,IDC_NS_GROUP_NAME),door_text(ns_control(s,IDC_NS_NAME)));u.default_real=p==0;door_check(ns_control(s,IDC_NS_REAL),u.default_real);}break;
    case IDC_NS_NEXT:if(ns_collect(s)){++u.step;ns_fill(s);}break;
    case IDC_NS_BACK:if(u.step>1){if(!ns_collect(s))u.uncollected[u.step]=true;--u.step;ns_fill(s);}break;
    case IDC_NS_CANCEL:
        if(!u.edited || ftn_confirm(s,L"Cancel Network Setup",L"Discard the unsaved network settings? Saved networks and messages are preserved.")){
            ns_end(s);s.ftn.draft.reset();s.ftn.draft_changed=false;activate_page(s,29);ns_show(s);
        }
        break;
    case IDC_NS_BROWSE:ns_browse(s,IDC_NS_PATH,false);SendMessageW(ns_control(s,IDC_NS_SOURCE),CB_SETCURSEL,0,0);break;
    case IDC_NS_MSG_BROWSE:ns_browse(s,IDC_NS_MSG_PATH,true);break;
    case IDC_NS_NODE_BROWSE:ns_browse(s,IDC_NS_NODE_PATH,false);break;
    case IDC_NS_LOAD:ns_load(s);break;
    case IDC_NS_SEARCH:case IDC_NS_CLONE_SEARCH:if(notification==EN_CHANGE)ns_rows(s);break;
    case IDC_NS_ALL_REAL:case IDC_NS_ALL_ANSI:case IDC_NS_ALL_PIPE:if(notification==BN_CLICKED){auto c=*ftn_current(s);const auto on=SendMessageW(ns_control(s,id),BM_GETCHECK,0,0)==BST_CHECKED;for(auto& e:c.message_echoes)if(e.network==u.network){if(id==IDC_NS_ALL_REAL)e.require_real_name=on;else if(id==IDC_NS_ALL_ANSI)e.ansi_colors=on;else{e.update_local_permissions|=e.local_echo&&e.pipe_colors!=on;e.pipe_colors=on;}}s.ftn.draft=std::move(c);ns_mark(s);ns_rows(s);}break;
    case IDC_NS_ADD:ns_manual(s);break;
    case IDC_NS_ALL:case IDC_NS_NONE:for(auto& e:u.list.entries)e.selected=id==IDC_NS_ALL;ns_mark(s);ns_rows(s);break;
    case IDC_NS_APPLY:case IDC_NS_APPLY_ALL:ns_apply_row(s,id==IDC_NS_APPLY_ALL);break;
    case IDC_NS_ENABLE:if(s.ftn.draft){s.ftn.draft->networks[s.ftn.network].enabled=door_checked(ns_control(s,id));EnableWindow(ns_control(s,IDC_NS_QUEUE),u.prepared&&door_checked(ns_control(s,id))&&!ns_tags(s).empty());ns_mark(s);}break;
    case IDC_NS_SAVE:ns_save(s,false);break;
    case IDC_NS_QUEUE:ns_save(s,true);break;
    case IDC_NS_CLONE:ns_clone(s,false);break;
    case IDC_NS_CLONE_ALL:u.clone_preview.reset();EnableWindow(ns_control(s,IDC_NS_CLONE_APPLY),FALSE);u.clone_targets=ns_tags(s);ns_rows(s);break;
    case IDC_NS_CLONE_CLEAR:u.clone_preview.reset();EnableWindow(ns_control(s,IDC_NS_CLONE_APPLY),FALSE);u.clone_targets.clear();ns_rows(s);break;
    case IDC_NS_CLONE_PREVIEW:ns_clone_preview(s);break;
    case IDC_NS_CLONE_APPLY:if(u.clone_preview){auto c=*ftn_current(s);const auto result=app::apply_ftn_echo_options(c,u.network,u.preview_targets,*u.clone_preview);if(result.succeeded()){s.ftn.draft=std::move(c);ns_mark(s);ns_rows(s);set_status(s,L"Reviewed clone fields applied to the draft. Save commits these settings.");}}break;
    case IDC_NS_CLONE_BACK:{const bool editor=u.clone_from_editor;u.clone=u.clone_from_editor=false;ns_show(s);if(editor){activate_page(s,32);ftn_echo_fill(s);}else ns_fill(s);break;}
    default:break;
    }return true;
}
std::optional<LRESULT> ns_notify(State& s,const NMHDR* header){
    if(header->idFrom!=IDC_NS_ROWS||s.ftn.populating)return {};auto& u=s.ftn.setup;if(header->code==LVN_ITEMCHANGED){const auto* row=reinterpret_cast<const NMLISTVIEW*>(header);if(row->iItem<0||static_cast<std::size_t>(row->iItem)>=u.visible.size())return 0;const auto index=u.visible[row->iItem];
        if((row->uChanged&LVIF_STATE)&&((row->uOldState^row->uNewState)&LVIS_STATEIMAGEMASK)){const bool checked=ListView_GetCheckState(header->hwndFrom,row->iItem)!=FALSE;if(u.clone){const auto* c=ftn_current(s);if(c&&index<c->message_echoes.size()){const auto tag=c->message_echoes[index].tag;u.clone_targets.erase(std::remove(u.clone_targets.begin(),u.clone_targets.end(),tag),u.clone_targets.end());if(checked)u.clone_targets.push_back(tag);u.clone_preview.reset();EnableWindow(ns_control(s,IDC_NS_CLONE_APPLY),FALSE);}}else if(u.step==3&&index<u.list.entries.size()){u.list.entries[index].selected=checked;ns_mark(s);}ns_counts(s);}
        if(!u.clone&&u.step!=3&&(row->uNewState&LVIS_SELECTED)){const auto* c=ftn_current(s);if(c&&index<c->message_echoes.size()){s.ftn.populating=true;const auto& e=c->message_echoes[index];door_set(ns_control(s,IDC_NS_CALLER_NAME),e.local_name);door_set_number(ns_control(s,IDC_NS_ACCESS),e.access_level);door_set_number(ns_control(s,IDC_NS_READ),e.read_level);door_set_number(ns_control(s,IDC_NS_POST),e.post_level);door_check(ns_control(s,IDC_NS_REAL),e.require_real_name);door_check(ns_control(s,IDC_NS_ANSI),e.ansi_colors.value_or(true));door_check(ns_control(s,IDC_NS_PIPE),e.pipe_colors);door_set(ns_control(s,IDC_NS_COUNT),e.maximum_messages?std::to_string(*e.maximum_messages):"Unlimited");door_set(ns_control(s,IDC_NS_AGE),e.maximum_age_days?std::to_string(*e.maximum_age_days):"0");s.ftn.populating=false;}}return 0;}
    return {};
}
bool ns_save(State& s,bool queue){
    auto& u=s.ftn.setup;if(!u.active||u.step!=9||!s.ftn.draft)return false;auto c=*s.ftn.draft;auto& n=c.networks[s.ftn.network];n.enabled=door_checked(ns_control(s,IDC_NS_ENABLE));
    if(queue&&(!u.prepared||!n.enabled||u.hub.empty())){ns_error(s,L"Prepare the AreaFix request and enable the network before queueing.");return false;}
    // The queued request is a command bound into this configuration receipt,
    // never a second unsynchronised write after Save.
    if(queue)c.setup_subscriptions=app::FtnSetupSubscriptions{u.network,u.hub,ns_tags(s)};
    if(!ftn_commit(s,c))return false;ns_end(s);s.ftn.draft=*s.ftn.config;activate_page(s,30);ns_show(s);ftn_network_fill(s);remember_page(s);set_status(s,queue?L"Network saved. AreaFix request queued; hub acceptance is pending.":L"Network saved. No AreaFix request was queued.");return true;
}
