void ftn_permissions_fill(State& s){
    s.ftn.permission_edits=false;
    auto& f=s.ftn;const auto* c=ftn_current(s);if(!c||f.network<0)return;f.populating=true;SendMessageW(f.permission_links,CB_RESETCONTENT,0,0);const auto& network=c->networks[f.network].code;
    for(std::size_t i=0;i<c->links.size();++i)if(c->links[i].network==network)ftn_combo_item(f.permission_links,utf8_to_wide(c->links[i].name),i);
    if(f.permission_link>=0&&(static_cast<std::size_t>(f.permission_link)>=c->links.size()||c->links[f.permission_link].network!=network))f.permission_link=-1;
    const auto remembered=std::find_if(f.permission_choices.begin(),f.permission_choices.end(),[&](const auto& v){return v.first==network;});
    if(f.permission_link<0&&remembered!=f.permission_choices.end()){for(std::size_t i=0;i<c->links.size();++i)if(c->links[i].network==network&&c->links[i].code==remembered->second)f.permission_link=static_cast<int>(i);}
    if(f.permission_link<0&&f.link>=0&&static_cast<std::size_t>(f.link)<c->links.size()&&c->links[f.link].network==network)f.permission_link=f.link;
    if(f.permission_link<0){int sole=-1;for(std::size_t i=0;i<c->links.size();++i)if(c->links[i].network==network){if(sole>=0){sole=-1;break;}sole=static_cast<int>(i);}f.permission_link=sole;}
    ftn_combo_select(f.permission_links,f.permission_link);ListView_DeleteAllItems(f.permission_rows);f.permission_items.clear();
    const bool valid=f.permission_link>=0&&static_cast<std::size_t>(f.permission_link)<c->links.size()&&c->links[f.permission_link].network==network;
    const auto add=[&](const std::string& tag,bool file){
        const auto row=static_cast<int>(f.permission_items.size());f.permission_items.push_back({tag,file});auto title=utf8_to_wide(tag);LVITEMW item{};item.mask=LVIF_TEXT|LVIF_PARAM;item.iItem=row;item.pszText=title.data();item.lParam=row;ListView_InsertItem(f.permission_rows,&item);
        auto type=file?std::wstring(L"Files"):std::wstring(L"Messages");ListView_SetItemText(f.permission_rows,row,1,type.data());std::wstring rights=L"No access";
        if(valid){const auto& link=c->links[f.permission_link];const auto p=std::find_if(c->permissions.begin(),c->permissions.end(),[&](const auto& v){return v.network==network&&v.link==link.code&&v.tag==tag&&v.file_echo==file;});if(p!=c->permissions.end())rights=(p->receive?std::wstring(L"Receive "):L"")+(p->send?L"Send ":L"")+(p->manage?L"AreaFix":L"");if(rights.empty())rights=L"No access";}
        ListView_SetItemText(f.permission_rows,row,2,rights.data());
    };
    if(valid){for(const auto& e:c->message_echoes)if(e.network==network)add(e.tag,false);for(const auto& e:c->file_echoes)if(e.network==network)add(e.tag,true);
        const auto value=c->links[f.permission_link].code;auto found=std::find_if(f.permission_choices.begin(),f.permission_choices.end(),[&](const auto& v){return v.first==network;});if(found==f.permission_choices.end())f.permission_choices.push_back({network,value});else found->second=value;
    }else{LVITEMW item{};item.mask=LVIF_TEXT;item.pszText=const_cast<wchar_t*>(L"Choose a connection above.");ListView_InsertItem(f.permission_rows,&item);}
    EnableWindow(f.permission_rows,TRUE);for(auto h:{f.permission_receive,f.permission_send,f.permission_manage,GetDlgItem(s.pages[38],IDC_FTN_PERMISSION_APPLY)})EnableWindow(h,valid);for(auto h:{f.permission_receive,f.permission_send,f.permission_manage})door_check(h,false);f.populating=false;
}
void ftn_permissions_selected(State& s){auto& f=s.ftn;if(ListView_GetSelectedCount(f.permission_rows)!=1)return;const auto row=ListView_GetNextItem(f.permission_rows,-1,LVNI_SELECTED);const auto* c=ftn_current(s);if(!c||row<0||static_cast<std::size_t>(row)>=f.permission_items.size()||f.permission_link<0)return;const auto& key=f.permission_items[row];const auto& link=c->links[f.permission_link];const auto p=std::find_if(c->permissions.begin(),c->permissions.end(),[&](const auto& v){return v.network==link.network&&v.link==link.code&&v.tag==key.tag&&v.file_echo==key.file;});door_check(f.permission_receive,p!=c->permissions.end()&&p->receive);door_check(f.permission_send,p!=c->permissions.end()&&p->send);door_check(f.permission_manage,p!=c->permissions.end()&&p->manage);EnableWindow(f.permission_manage,!key.file);}
bool ftn_permissions_apply(State& s){
    auto& f=s.ftn;auto c=*ftn_current(s);if(f.permission_link<0||static_cast<std::size_t>(f.permission_link)>=c.links.size()){set_status(s,L"Select a connection first.");return false;}const auto& link=c.links[f.permission_link];const auto receive=door_checked(f.permission_receive),send=door_checked(f.permission_send),manage=door_checked(f.permission_manage);unsigned count{};
    for(int row=-1;(row=ListView_GetNextItem(f.permission_rows,row,LVNI_SELECTED))>=0;){if(static_cast<std::size_t>(row)>=f.permission_items.size())return false;const auto& key=f.permission_items[row];if(key.file&&manage){set_status(s,L"AreaFix manages message echoes only. Clear AreaFix for a selection containing file echoes.");return false;}auto p=std::find_if(c.permissions.begin(),c.permissions.end(),[&](const auto& v){return v.network==link.network&&v.link==link.code&&v.tag==key.tag&&v.file_echo==key.file;});if(p==c.permissions.end()){c.permissions.push_back({link.network,link.code,key.tag,key.file,receive,send,manage});}else{p->receive=receive;p->send=send;p->manage=manage;}++count;}
    if(!count){set_status(s,L"Select one or more named echoes. No access is granted automatically.");return false;}f.draft=std::move(c);f.draft_changed=true;ftn_permissions_fill(s);remember_page(s);set_status(s,L"Updated access for "+std::to_wstring(count)+L" selected echoes in this draft. Save Changes to commit it.");return true;
}
