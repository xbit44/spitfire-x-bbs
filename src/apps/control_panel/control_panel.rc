#include <windows.h>
#include "resource.h"
#include "../product_version.h"

IDD_EVENT_SOUNDS DIALOGEX 0, 0, 400, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "Event Sounds"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Assign local WAV files. Blank assignments are silent.",IDC_SOUND_HINT,8,7,384,12
    CONTROL "",IDC_SOUND_ROWS,"STATIC",WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_VSCROLL,8,24,384,156,WS_EX_CONTROLPARENT
    LTEXT "Select an event to Test or Clear. Browse does not play a sound.",IDC_SOUND_STATUS,8,184,384,26
    PUSHBUTTON "Test Selected",IDC_SOUND_TEST,8,212,56,16
    PUSHBUTTON "Stop",IDC_SOUND_STOP,69,212,38,16
    PUSHBUTTON "Clear Selected",IDC_SOUND_CLEAR,112,212,56,16
    DEFPUSHBUTTON "Save Changes",IDOK,264,212,62,16
    PUSHBUTTON "Exit",IDCANCEL,330,212,56,16
END

IDD_CHAT_NOTICE DIALOGEX 0, 0, 360, 204
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Send System Notice"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Destination",-1,12,12,332,12
    COMBOBOX IDC_NOTICE_SCOPE,12,28,336,130,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Notice (up to 512 characters)",-1,12,54,332,12
    EDITTEXT IDC_NOTICE_TEXT,12,70,336,52,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Review the destination and text before sending.",IDC_NOTICE_RESULT,12,132,336,28
    DEFPUSHBUTTON "Review",IDOK,164,174,88,20
    PUSHBUTTON "Cancel",IDCANCEL,260,174,88,20
END

IDD_OPERATOR_CHAT DIALOGEX 0, 0, 420, 292
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Chat with Caller"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Connecting...",IDC_OPERATOR_STATUS,12,10,396,24
    EDITTEXT IDC_OPERATOR_HISTORY,12,38,396,188,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Message",-1,12,234,50,12
    EDITTEXT IDC_OPERATOR_TEXT,64,232,344,16,ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Send",IDOK,224,260,88,20
    PUSHBUTTON "End Chat",IDCANCEL,320,260,88,20
END

IDR_OWNER_NODE_VIEW_ANSI RCDATA "assets\\owner\\sfx-node-view.ans"
IDR_OWNER_SCREEN_SAVER_ANSI RCDATA "assets\\owner\\sf-x-ss.ans"
IDI_CONTROL_PANEL ICON "assets\\owner\\sfx-control-panel-icon.ico"
IDR_OWNER_ABOUT_ARTWORK RCDATA "assets\\owner\\sfx-about-approved.png"
IDR_MOEBIUS_CP437_FONT RCDATA "assets\\owner\\moebius-cp437.f16"

IDD_FIRST_RUN DIALOGEX 0, 0, 356, 342
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Spitfire-X BBS First-Run Setup"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Configure this Spitfire-X BBS installation",IDC_SETUP_HEADING,12,10,330,18
    LTEXT           "BBS name:",-1,12,36,86,10
    EDITTEXT        IDC_BBS_NAME,104,34,236,14,ES_AUTOHSCROLL
    LTEXT           "Sysop caller name:",-1,12,57,86,10
    EDITTEXT        IDC_SYSOP_NAME,104,55,236,14,ES_AUTOHSCROLL
    LTEXT           "Sysop password:",-1,12,78,86,10
    EDITTEXT        IDC_ACCOUNT_PASSWORD,104,76,106,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Confirm:",-1,218,78,42,10
    EDITTEXT        IDC_ACCOUNT_CONFIRM,264,76,76,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "SY: password:",-1,12,99,86,10
    EDITTEXT        IDC_SYSTEM_PASSWORD,104,97,106,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Confirm:",-1,218,99,42,10
    EDITTEXT        IDC_SYSTEM_CONFIRM,264,97,76,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "BBS time zone:",-1,12,120,86,10
    COMBOBOX        IDC_TIME_ZONE,104,118,236,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Logical nodes:",-1,12,143,86,10
    EDITTEXT        IDC_LOGICAL_NODES,104,141,42,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Telnet listener (starts when you choose Save Setup and Start BBS)",-1,12,166,328,12
    LTEXT           "Bind address:",-1,12,189,86,10
    EDITTEXT        IDC_TELNET_BIND,104,187,92,14,ES_AUTOHSCROLL
    LTEXT           "Port:",-1,210,189,28,10
    EDITTEXT        IDC_TELNET_PORT,242,187,48,14,ES_NUMBER | ES_AUTOHSCROLL
    GROUPBOX        "SSH listener",-1,12,209,328,64
    CONTROL         "Enable SSH listener",IDC_SETUP_SSH_ENABLED,"BUTTON",BS_AUTOCHECKBOX | WS_TABSTOP,24,222,180,12
    LTEXT           "Bind address:",-1,24,250,76,10
    EDITTEXT        IDC_SETUP_SSH_BIND,104,248,92,14,ES_AUTOHSCROLL
    LTEXT           "Port:",-1,210,250,28,10
    EDITTEXT        IDC_SETUP_SSH_PORT,242,248,48,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Passwords are sent only to the owned local runtime and are never saved as text.",-1,12,283,328,20
    DEFPUSHBUTTON   "Save Setup and Start BBS",IDOK,126,316,133,16
    PUSHBUTTON      "Finish Later",IDCANCEL,266,316,74,16
END

IDD_ABOUT DIALOGEX 0, 0, 300, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Spitfire-X BBS"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "",IDC_ABOUT_IMAGE,"STATIC",SS_OWNERDRAW | WS_CHILD | WS_VISIBLE,12,12,276,276
    LTEXT           "",IDC_ABOUT_VERSION,12,296,276,16,SS_CENTER | SS_CENTERIMAGE
    CONTROL         "Close",IDOK,"BUTTON",BS_OWNERDRAW | BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP,115,318,70,16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SFX_PRODUCT_VERSION_NUMERIC
 PRODUCTVERSION SFX_PRODUCT_VERSION_NUMERIC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Spitfire-X\0"
      VALUE "FileDescription", "Spitfire-X BBS Control Panel\0"
      VALUE "FileVersion", SFX_PRODUCT_VERSION_STRING
      VALUE "InternalName", "SFXControlPanel\0"
      VALUE "OriginalFilename", "SFXControlPanel.exe\0"
      VALUE "ProductName", "Spitfire-X BBS\0"
      VALUE "ProductVersion", SFX_PRODUCT_VERSION_PRODUCT_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
